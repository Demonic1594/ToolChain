  expanded_description: "Raises the Pokemon's Attack stat by one stage when switching into battle."
}
ability {
  id: ABILITY_EMBODY_ASPECT_CORNERSTONE
  name: "Embody Aspect"
  description: "On entry, raises Defense by one stage."
  expanded_description: "Raises the Pokemon's Defense stat by one stage when switching into battle."
}
ability {
  id: ABILITY_EMBODY_ASPECT_WELLSPRING
  name: "Embody Aspect"
  description: "On entry, raises Special Defense by one stage."
  expanded_description: "Raises the Pokemon's Special Defense stat by one stage when switching into battle."
}
ability {
  id: ABILITY_ROCKHARD_SHAFT
  name: "We Will Rock You"
  description: "Boosts Rock-type moves by 1.3x, or 1.8x when under 1/3 HP."
  expanded_description: "Boosts the power of Rock-type moves by 30%, or by 80% at 1/3 HP or lower."
}
ability {
  id: ABILITY_DEVIATE
  name: "Deviate"
  description: "Normal moves become Dark. Dark moves are empowered."
  expanded_description: "Changes the user's Normal-type moves to Dark-type. If the user is Dark-type its Dark-type moves have a 10% enrage chance, otherwise it gains Dark STAB."
}
ability {
  id: ABILITY_SUNS_BOUNTY
  name: "Sun's Bounty"
  description: "Leaf Guard + Harvest."
  expanded_description: "During sun, cures all status conditions at at the end of the turn; and 50% chance to restore berry on turn end, 100% in sun. Includes berries that were used for Fling, Natural Gift, or eaten."
}
ability {
  id: ABILITY_RITE_OF_SPRING
  name: "Rite Of Spring"
  description: "Chlorophyll + Solar Power."
  expanded_description: "Boosts the user's Speed and highest attacking stat by 50% when sun is active."
}
ability {
  id: ABILITY_HEADSTRONG
  name: "Headstrong"
  description: "On entry, raises Special Defense by one stage."
  expanded_description: "Raises the Pokemon's Special Defense stat by one stage when switching into battle."
}
ability {
  id: ABILITY_FIREFIGHTER
  name: "Firefighter"
  description: "Deals 1.5x damage to Fire. Takes 0.5x damage from Fire."
  expanded_description: "Deals 1.5x damage to Fire-type Pokemon and takes 0.5x damage when attacked by Fire-type Pokemon. Based on attacker/defender Pokemon types, not move types. The damage reduction is multiplicative with other sources."
}
ability {
  id: ABILITY_SEPIA_LENS
  name: "Sepia Lens"
  description: "Tinted Lens + Sand Guard."
  expanded_description: "Combines Tinted Lens and Sand Guard. Doubles damage when attacking with not very effective moves. During sandstorm, blocks priority moves from opponents and halves damage from special attacks. Also grants immunity to sandstorm damage like other Ground-types."
}
ability {
  id: ABILITY_SUPER_SNIPER
  name: "Super Sniper"
  description: "Sniper + Attacks hit switching foes with 1/2 Power."
  expanded_description: "Boosts critical hit damage from 1.5x to 2.25x by applying an additional 50% multiplier. Attacks strike foes before they finish switching out for 50% power, damaging them before leaving."
}
ability {
  id: ABILITY_WOODLAND_CURSE
  name: "Woodland Curse"
  description: "Uses Forest's Curse on Entry. Adds Grass type on contact."
  expanded_description: "Upon entering battle, uses Forest's Curse on a random opponent, adding Grass typing. When opponents make contact with the user, they also gain Grass as an extra type. Only affects non-Grass types. Persists until switching out."
}
ability {
  id: ABILITY_MALODOR
  name: "Malodor"
  description: "Suppresses attacker's abilities on contact."
  expanded_description: "When hit by a contact move, the user suppresses the attacker's ability and innates until they switch out."
}
ability {
  id: ABILITY_BLUR
  name: "Blur"
  description: "Uses Speed as defensive stat when hit by contact."
  expanded_description: "When hit by contact moves, the Pokemon uses its Speed stat instead of Defense or Special Defense for damage calculations. Choice Scarf does not affect this ability."
}
ability {
  id: ABILITY_ELUDE
  name: "Elude"
  description: "Uses Speed as defensive stat when hit by non-contact."
  expanded_description: "When hit by non-contact moves, the Pokemon uses its Speed stat instead of Defense or Special Defense for damage calculations. Choice Scarf does not affect this ability."
}
ability {
  id: ABILITY_DRAKE_OF_RAGE
  name: "Drake Of Rage"
  description: "Tinted Lens + Rampage"
  expanded_description: "Doubles damage when attacking into resistances. If a move would be resisted (0.5x damage or less), the damage is multiplied by 2x. Eliminates recharge turns when the user successfully KOs an opponent with a direct attack."
}
ability {
  id: ABILITY_REVERBATE
  name: "Reverberate"
  description: "Normal moves are Sound moves."
  expanded_description: "Converts all Normal-type moves into Sound moves, enabling them to benefit from sound-based abilities and interactions."
}
ability {
  id: ABILITY_MIXED_MARTIAL_ARTS
  name: "Mixed Martial Arts"
  description: "Normal moves are flagged as Punch + Kick moves."
  expanded_description: "Converts all Normal-type moves into Iron Fist and Striker moves, enabling them to benefit from related abilities and interactions."
}
ability {
  id: ABILITY_STRATEGIC_PAUSE
  name: "Strategic Pause"
  description: "+2 crit rate when moving last + Analytic."
  expanded_description: "When the user moves after the target, boosts critical hit ratio by 2 stages and attack power by 30%."
}
ability {
  id: ABILITY_OVERRULE
  name: "Overrule"
  description: "Crits bypass abilities and do 2x damage vs resists."
  expanded_description: "When this Pokemon's moves land critical hits, they ignore defensive abilities that would normally reduce damage and their attacks deal double damage if they are resisted. For multi-hit attacks abilities are either ignored for all hits if the first is a crit or no hits otherwise."
}
ability {
  id: ABILITY_MENTAL_POLLUTION
  name: "Mental Pollution"
  description: "Suppresses others' abilities when it becomes enraged."
  expanded_description: "Applies ability suppression to other Pokemon when the user becomes enraged. Suppression lasts while those Pokemon remain on the field. Pokemon with Mental Pollution are unaffected."
}
ability {
  id: ABILITY_MADNESS_ENHANCEMENT
  name: "Madness Enhancement"
  description: "Enrages in fog, reduces damage taken by 20% when enraged."
  expanded_description: "Becomes enraged when entering fog. All incoming damage is reduced by 20% when the user is enraged and it takes no damage from enrage."
}
ability {
  id: ABILITY_TENTALOCK
  name: "Tentalock"
  description: "Grappler + Serpent Bind."
  expanded_description: "Trapping moves last 6 turns instead of 4-5 turns and increases their damage at the end of the turn to 1/6 max HP per turn. Gives attacks a 50% chance to trap the target for 6 turns, preventing escape or switching. Once trapped, their speed drops by one stage each turn they remain on the field."
}
ability {
  id: ABILITY_SERPENT_BIND
  name: "Serpent Bind"
  description: "50% chance to trap. Lowers Speed of trapped foes -1 each turn."
  expanded_description: "Gives attacks a 50% chance to trap the target for 4-5 turns, preventing escape or switching. Once trapped, their speed drops by one stage each turn they remain on the field."
}
ability {
  id: ABILITY_SOUL_TAP
  name: "Soul Tap"
  description: "Drain 10% HP from foes at the end of each turn in fog."
  expanded_description: "While fog is active, drains 1/10 of each active opponent's max HP at the end of every turn and restores that amount to the user. Ignores Substitute."
}
ability { 
  id: ABILITY_SCARECROW
  name: "Scarecrow"
  description: "Scare + Cotton Down."
  expanded_description: "Upon entering battle, the user drops the Special Attack stat of all opposing Pokemon by one stage. When the user is hit by any attack, it lowers the Speed of all opposing Pokemon by one stage. Activates multiple times against multihit moves."
}
ability {
  id: ABILITY_OMINOUS_SHROUD
  name: "Ominous Shroud"
  description: "Phantom + Shadow Shield."
  expanded_description: "Upon entering battle, adds Ghost to user's current typing. Retains Ghost typing even upon losing the ability, going away only when switching out. Halves damage from all attacks when at full HP. Multiplicative with other damage reduction sources."
}
ability {
  id: ABILITY_CHILLING_PRESENCE
  name: "Chilling Presence"
  description: "Attacks with 10BP Icy Wind on switch-in."
  expanded_description: "Uses a 10BP Icy Wind (Ice, Special, Air-based) on entry, hitting all opponents and lowering their Speed by 1 stage."
}
ability {
  id: ABILITY_FROSTBIND
  name: "Frostbind"
  description: "Inflicting Frostbite also inflicts Disable."
  expanded_description: "When inflicting frostbite, the user also inflicts disable. Disable prevents the target from using their last-used move for 4 turns. Fails if the target has not moved yet."
}
ability {
  id: ABILITY_GLACIAL_GHOST
  name: "Glacial Ghost"
  description: "Slush Rush + Snow Cloak."
  expanded_description: "Boosts the Pokemon's Speed by 50% and its evasion by 25% during hail. Immune to hail damage."
}
ability {
  id: ABILITY_TENDER_AFFECTION
  name: "Tender Affection"
  description: "Cute Charm + Fairy STAB"
  expanded_description: "When hit by contact moves, has a 50% chance to infatuate the attacker (cuts their Attack and Special Attack in half). Also gives STAB to Fairy-type moves."
}
ability {
  id: ABILITY_WONDER_SCALE
  name: "Wonder Scale"
  description: "Shed Skin + Wonder Skin"
  expanded_description: "At the end of each turn, there's a 30% chance for the user to cure status conditions afflicted on them. Immune to all damage boosting ability effects from opponents, other than Parental Bond and Multi-Headed."
}
ability {
  id: ABILITY_OVERZEALOUS
  name: "Overzealous (N)"
  description: "User's super-effective moves have +1 prio."
  expanded_description: "Will not be implemented."
}
ability {
  id: ABILITY_STAINLESS_STEEL
  name: "Stainless Steel"
  description: "Fort Knox + Steelworker."
  expanded_description: "The user ignores most abilities that increase damage or hit additional times. Changes the user's Normal-type moves to Steel-type. If the user is Steel-type it resists Ghost and Steel, otherwise it gains Steel STAB."
}
ability {
  id: ABILITY_TEMPORAL_RUPTURE
  name: "Temporal Rupture"
  description: "Roar of Time is altered drastically."
  expanded_description: "Roar of Time becomes a 100 BP +0 Priority attack that changes the target's Ability to Slow Start (halves attacking stats and speed for 5 turns) but no longer forces the target to switch."
}
ability {
  id: ABILITY_GRASS_FLUTE
