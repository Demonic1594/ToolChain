  description: "Sound moves inflict Fear."
  expanded_description: "Sound moves inflict Fear on hit. Fear traps the target for 2 turns and they take 50% more damage. If forced out by moves like Whirlwind, the target loses Fear."
}
ability {
  id: ABILITY_HEMOTOXIN
  name: "Hemotoxin"
  description: "Suppresses abilities of the target when they're poisoned."
  expanded_description: "Negates the opponent's ability and innates when the user successfully poisons them. Suppression wears off after they switch out."
}
ability {
  id: ABILITY_HARUKAZE
