  id: ABILITY_SAND_TITAN
  name: "Sand Titan"
  description: "Juggernaut + Sand Stream"
  expanded_description: "Adds 20% of the user's Defense stat to attack calculations for contact moves. Prevents paralysis, immediately curing it if inflicted on the user. Summons a sandstorm for 8 turns (12 with Smooth Rock) on entry. Immune to sandstorm damage."
}
ability {
  id: ABILITY_FAMILIA_BOND
  name: "Familia Bond"
  description: "Moves hit twice. 1st hit at 100% power, 2nd hit at 50%."
  expanded_description: "All attacks hit twice in succession. The first hit deals 100%, while the second hit deals 50%. Each hit rolls secondary effects independently (except flinch). Bypasses Fort Knox/Wonder Skin."
}
ability {
  id: ABILITY_MEGA_SOL
  name: "Mega Sol"
  description: "Chloroplast + Grassy Surge"
  expanded_description: "Moves used by the user act as if the weather is harsh sunlight. Creates Grassy Terrain for 8 turns (12 with Terrain Extender) on entry."
}
ability {
  id: ABILITY_PETROLEUM_JELLY
  name: "Petroleum Jelly"
  description: "Hyper Cleanse + Liquified"
  expanded_description: "Immune to status. Halves damage taken from Poison-type attacks and contact moves, but doubles damage taken from Water-type attacks."
}
ability {
  id: ABILITY_SPICY_SPRAY
  name: "Spicy Spray"
  description: "Taking damage from a move burns the attacker."
  expanded_description: "When the user is hit by any damaging move, the attacker will become burned."
}
ability {
  id: ABILITY_CRIMSON_CROWN
  name: "Crimson Crown"
  description: "Spike Armor + Mighty Horn"
  expanded_description: "30% chance to inflict bleeding on contact moves, both when attacking and being attacked. Boosts the power of horn and drill-based attacks by 30%."
}
ability {
  id: ABILITY_MANA_COAT
  name: "Mana Coat"
  description: "Physical attacks deal 30% more damage on Psychic Terrain."
  expanded_description: "The user's physical attacks deal 30% increased damage while Psychic Terrain is active. Works even if the user is grounded."
}
ability {
  id: ABILITY_HEMORRHAGE
  name: "Hemorrhage"
  description: "Supresses target's abilities when user inflicts bleeding."
  expanded_description: "Negates the opponent's ability and innates when the user successfully inflicts bleed on them. Suppression wears off after they switch out."
}
ability {
  id: ABILITY_OVERCLOCK
  name: "Overclock"
  description: "Ground Shock + Overcharge"
  expanded_description: "The user's Electric-type moves hit Ground types for not very effective damage instead of no effect, and hit Electric types for super effective damage instead of not very effective. The user can paralyze Electric types."
}
ability {
  id: ABILITY_ABSOLUTE_GUARD
  name: "Absolute Guard"
  description: "Magic Guard + Clueless + Sturdy + Wonder Guard"
  expanded_description: "The user only takes damage from direct attacks, ignoring all field effects such as weather, rooms, or terrains, and always survives an attack that would knock it out with 1 HP remaining, as long as it was at full HP."
}
ability {
  id: ABILITY_SOVEREIGN_PROWESS
  name: "Sovereign Prowess"
  description: "Equinox + Huge Power + Feline Prowess"
  expanded_description: "The user's Attack and Special Attack stats are both doubled, and its damaging moves use whichever of Attack or Special Attack is higher, regardless of the move's normal category."
}
ability {
  id: ABILITY_FLUFFIEST_ONE
  name: "Fluffiest One"
  description: "Elude + Fluffiest + Momentum + Impulse"
  expanded_description: "All of the user's moves, contact or not, use its Speed stat for damage instead of Attack or Special Attack. When hit by a non-contact move, the user's Speed stat is used defensively instead of Defense or Special Defense. Contact damage taken is halved, but Fire-type moves deal double damage."
}
ability {
  id: ABILITY_ARCANE_STANCE
  name: "Arcane Stance"
  description: "Signature moves shift the user's stance."
  expanded_description: "Mystique Armament shifts the user to Sword Forme and strikes both opposing Pokemon with the most effective type; Mystic Aegis returns it to Shield Forme, or raises its Defenses if it already is."
}
ability {
  id: ABILITY_BLADEMASTER
  name: "Blademaster"
  description: "Sharpens slicing moves."
  expanded_description: "Keen Edge (slicing) moves deal 20% more damage and land boosted critical hits."
}
ability {
  id: ABILITY_PROMISED_VICTORY
  name: "Promised Victory"
  description: "Attack rises on entry and when struck."
  expanded_description: "Raises Attack by one stage upon entering battle and whenever it is struck, maximizing it on critical hits. Keen Edge (slicing) moves deal 20% more damage, land boosted critical hits, never miss, and pierce protection, substitutes, and screens."
}
ability {
  id: ABILITY_PROPHETIC_DESTINY
  name: "Prophetic Destiny"
  description: "Sees attacks coming: priority fails, crits never land."
  expanded_description: "Opposing priority moves fail against the user and its ally. Physical moves deal 20% more damage, and each KO it scores raises its Attack and Speed by one stage. It takes halved Fire damage and can never be critically hit."
}
ability {
  id: ABILITY_BEAST_OF_GLUTTONY
  name: "Beast of Gluttony"
  description: "All damage taken is halved, and it snacks to endure."
  expanded_description: "All damage taken is halved. The first time it falls below half HP each time it enters battle, it restores 25% of its max HP. It eats a random berry at the end of each turn (earlier when weakened), and its type shifts to match its own strikes or to weather incoming ones."
}