  expanded_description: "All non-Ice-types lose 1/8 of their max HP at the end of each turn. Restores 1/8 max HP to Ice-types at the end of each turn."
}
ability {
  id: ABILITY_ENERGY_TAP
  name: "Energy Tap"
  description: "Heals the user for 1/8 of the damage they deal."
  expanded_description: "Heals the user for 1/8 of all damage they deal to opponents. Healing occurs immediately after damage is dealt. Minimum healing of 1 HP."
}
ability {
  id: ABILITY_SLUDGE_SPIT
  name: "Sludge Spit"
  description: "Triggers a 35BP Venom Bolt after using a move."
}
ability {
  id: ABILITY_SWAMP_THING
