# proto-file: AbilityList.proto
# proto-message: er.AbilityList

ability {
  id: ABILITY_NONE
  name: "-------"
  description: "Empty ability slot."
}
ability {
  id: ABILITY_STENCH
  name: "Stench"
  description: "10% chance to flinch targets. Toxic terrain is permanent."
  expanded_description: "Attacks gain +10% flinch chance. Chance is rolled separately on multi-hit attacks. Toxic Terrain turns do not decrease while the user is present."
}
ability {
  id: ABILITY_DRIZZLE
  name: "Drizzle"
  description: "Summons rain on entry. Lasts 8 turns."
  expanded_description: "Drizzle summons rain weather when the Pokemon enters battle, lasting 8 turns (12 with Damp Rock held). Rain boosts Water moves by 50% and cuts Fire damage by 50%. Certain moves and abilities have special interactions with rain. Cannot override primal weather conditions."
}
ability {
  id: ABILITY_SPEED_BOOST
  name: "Speed Boost"
  description: "Raises own Speed by one stage after every turn."
  expanded_description: "User's Speed increases by one stage at end of each full turn they remain on the field. Doesn't activate on the turn the user is switched in."
}
ability {
  id: ABILITY_BATTLE_ARMOR
  name: "Battle Armor"
  description: "Immune to critical hits. Takes 20% less damage from attacks."
  expanded_description: "Incoming damage is reduced by 20% (x0.8), multiplicative with other damage reduction. Additionally, critical hits are blocked, functioning as regular hits and not activating on-crit effects like To The Bone's bleed."
}
ability {
  id: ABILITY_STURDY
  name: "Sturdy"
  description: "At full HP, cannot be KO in one hit, stays at 1 HP instead."
  expanded_description: "When at full HP, this Pokemon will survive any single attack with at least 1 HP remaining. This functions like a Focus Sash, and so does not protect against multihit attacks or follow-up attacks (e.g. Aftershock, Thundercall)."
}
ability {
  id: ABILITY_DAMP
  name: "Damp"
  description: "Makes foe Water-type on contact. Also works on offense."
  expanded_description: "If the user makes contact with another Pokemon, offensively or defensively, the other Pokemon's type is changed to pure Water. This happens immediately for multihit or priority moves and can remove STAB in the middle of an enemy's multihit move."
}
ability {
  id: ABILITY_LIMBER
  name: "Limber"
  description: "Paralysis immune, halves recoil damage, negates self stat drop."
  expanded_description: "All recoil damage to the user is halved; this includes moves with scaling recoil damage like Brave Bird, moves with crash damage like Jump Kick, or moves with fixed recoil like Steel Beam. Paralysis also cannot affect the user, and if they gain Limber, existing paralysis is cured."
}
ability {
  id: ABILITY_SAND_VEIL
  name: "Sand Veil"
  description: "Evasion is boosted by 1.25x while a sandstorm is active."
  expanded_description: "During sandstorm, enemy Pokemon's accuracy is divided by 1.25, and user is immune to sand damage. Bypassed by No Guard/Mold Breaker."
}
ability {
  id: ABILITY_STATIC
  name: "Static"
  description: "30% chance to paralyze on contact, 10% on non-contact."
  expanded_description: "Has a chance to paralyze when attacking or when hit by a move. Has a 10% chance to paralyze on non-contact attacks and a 30% chance to paralyze on contact attacks."
}
ability {
  id: ABILITY_VOLT_ABSORB
  name: "Volt Absorb"
  description: "Heals 25% of max HP when hit by an Electric-type move."
  expanded_description: "This Pokemon absorbs Electric-type moves completely, converting them into energy that restores 25% of its maximum HP. Provides complete immunity to Electric damage and effects like paralysis from Thunder Wave. Absolutely perfect for Water/Flying types to remove their 4x Electric weakness."
}
ability {
  id: ABILITY_WATER_ABSORB
  name: "Water Absorb"
  description: "Heals 25% of max HP when hit by a Water-type move."
  expanded_description: "The user gains immunity to Water-type moves and they heal for 25% of their max HP when hit by them."
}
ability {
  id: ABILITY_OBLIVIOUS
  name: "Oblivious"
  description: "Immune to infatuation, Scare, Intimidate and disabling."
  expanded_description: "This Pokemon is immune to infatuation, Scare, Intimidate and disabling effects (Taunt, Disable, Encore, and Torment). When gaining this ability while afflicted by any of the mentioned statuses, instantly cures them."
}
ability {
  id: ABILITY_CLOUD_NINE
  name: "Cloud Nine"
  description: "Clears weather and prevents its effects."
  expanded_description: "Cloud Nine clears all weather upon switch-in and nullifies weather effects (including Primal weathers) while the user remains on the field. Weather can still be set, but provides no damage boosts or ability triggers until the user switches out."
}
ability {
  id: ABILITY_COMPOUND_EYES
  name: "Compound Eyes"
  description: "Grants a 1.3x accuracy boost."
  expanded_description: "Boosts the user's accuracy by 1.3x."
}
ability {
  id: ABILITY_INSOMNIA
  name: "Insomnia"
  description: "Cannot fall asleep. Rest fails if used."
  expanded_description: "Prevents falling asleep by any means, including sleep moves, abilities like Yawn, and other effects that cause sleep status. Rest will fail completely when used. If gained while asleep (via Worry Seed/Skill Swap), immediately wakes up. Can be bypassed by Mold Breaker and similar abilities. TEST"
}
ability {
  id: ABILITY_COLOR_CHANGE
  name: "Color Change"
  description: "Changes type to a resist or an immunity before getting hit."
  expanded_description: "Transforms the user into the best defensive type before taking damage. Prioritizes immunities over resistances. Only changes to a pure type. Once per turn."
}
ability {
  id: ABILITY_IMMUNITY
  name: "Immunity"
  description: "Cannot be poisoned. Halves damage taken from Poison moves."
  expanded_description: "Prevents poisoning. Reduces all Poison-type damage by 50%. Multiplicative with other sources of damage reduction. If poisoned when gaining this ability, the poison is immediately cured."
}
ability {
  id: ABILITY_FLASH_FIRE
  name: "Flash Fire"
  description: "Powers up Fire-type moves by 1.5x if hit by a Fire-type move."
  expanded_description: "Flash Fire grants complete immunity to Fire-type moves. When hit by Fire attacks, powers up the user's Fire moves by 50% until switching out. The boost doesn't stack from multiple Fire hits."
}
ability {
  id: ABILITY_SHIELD_DUST
  name: "Shield Dust"
  description: "Immune to added move effects, hazards, and powder moves."
  expanded_description: "Blocks all secondary effects from damaging moves. Grants immunity to entry hazards. Blocks all powder moves including Sleep Powder, Stun Spore, Poison Powder, Spore, Cotton Spore, Rage Powder, Powder, and Magic Powder."
}
ability {
  id: ABILITY_OWN_TEMPO
  name: "Own Tempo"
  description: "Immune to confusion, Intimidate and Scare."
  expanded_description: "Grants immunity to confusion, Intimidate, and Scare. Immediately cures confusion when receiving this ability."
}
ability {
  id: ABILITY_SUCTION_CUPS
  name: "Suction Cups"
  description: "Cannot be forced to switch out by an enemy's move."
  expanded_description: "Prevents forced switching from moves and Red Card."
}
ability {
  id: ABILITY_INTIMIDATE
  name: "Intimidate"
  description: "Lowers foes' Atk by one stage on entry."
  expanded_description: "Upon entering battle, the user drops the Attack stat of all opposing Pokemon by one stage."
}
ability {
  id: ABILITY_SHADOW_TAG
  name: "Shadow Tag"
  description: "Opponents can't be switched out. Ghosts aren't affected."
  expanded_description: "Prevents all non-Shadow Tag or Ghost-type foes from switching out. Pokemon holding Shed Shell or using a pivot move such as Flip Turn can escape. Activates during the next turn if the user switches in mid battle."
}
ability {
  id: ABILITY_ROUGH_SKIN
  name: "Rough Skin"
  description: "Enemies lose 1/8 of max HP if they hit user with contact move."
  expanded_description: "Damages attackers using contact moves for 1/8 of their max HP. Activates on every hit for multihitting moves."
}
ability {
  id: ABILITY_WONDER_GUARD
  name: "Wonder Guard"
  description: "Is only hit by Super-effective attacks or indirect damage."
  expanded_description: "Only super-effective attacks or indirect damage can hurt the user. All other direct attacks deal zero damage. Other sources such as poison or ability damage still function as normal."
}
ability {
  id: ABILITY_LEVITATE
  name: "Levitate"
  description: "Immune to Ground-type moves. Ups own Flying moves by 1.25x."
  expanded_description: "The user is immune to Ground-type moves and other ground effects such as Spikes and terrains. Boosts the damage of Flying-type moves by 25%."
}
ability {
  id: ABILITY_EFFECT_SPORE
  name: "Effect Spore"
  description: "30% chance to inflict SLP, PARA or PSN if hit by a contact move."
  expanded_description: "When hit by a contact move, 30% chance to inflict sleep, paralysis, or poison. Chosen randomly."
}
ability {
  id: ABILITY_SYNCHRONIZE
  name: "Synchronize"
  description: "Enemies inflicting status on this Pokémon get same status."
  expanded_description: "When inflicted with a non-volatile status (except sleep), the attacker receives the same status. Bypasses Substitute. If the user can cure the status when it is inflicted, they will inflict the status to the attacker before curing it."
}
ability {
  id: ABILITY_CLEAR_BODY
  name: "Clear Body"
  description: "Immune to stat drops."
  expanded_description: "Gives immunity to all stat reductions from moves and abilities. Includes self stat drops from moves like Overheat."
}
ability {
  id: ABILITY_NATURAL_CURE
  name: "Natural Cure"
  description: "Heals status condition upon switching out."
  expanded_description: "Cures all status conditions when switching out."
}
ability {
  id: ABILITY_LIGHTNING_ROD
  name: "Lightning Rod"
  description: "Redirects Electric moves. Absorbs them, ups highest Atk."
  expanded_description: "The user draws in Electric-type moves and gains immunity to them. Additionally, Electric-type moves boost the highest attacking stat of the user by one stage."
}
ability {
  id: ABILITY_SERENE_GRACE
  name: "Serene Grace"
  description: "Doubles chance of secondary effects on its own moves."
  expanded_description: "Doubles the activation chance of the user's secondary effects on their attacks."
}
ability {
  id: ABILITY_SWIFT_SWIM
  name: "Swift Swim"
  description: "This Pokémon's Speed gets a 1.5x boost if rain is active."
  expanded_description: "Boosts Speed by 50% during rain."
}
ability {
  id: ABILITY_CHLOROPHYLL
  name: "Chlorophyll"
  description: "This Pokémon's Speed gets a 1.5x boost if sun is active."
  expanded_description: "Boosts the Pokemon's Speed by 50% during sun."
}
ability {
  id: ABILITY_ILLUMINATE
  name: "Illuminate"
  description: "1.2x accuracy. Attacks remove Ghost-type from target."
  expanded_description: "Boosts the user's accuracy by 1.2x. Removes Ghost-type from the target when landing an attack."
}
ability {
  id: ABILITY_TRACE
  name: "Trace"
  description: "Copies the foe's ability. Does not copy innates."
  expanded_description: "Copies the ability of an opposing Pokemon when entering battle, replacing itself in the current ability slot. Cannot copy Trace, Wonder Guard, and most form related abilities. In doubles, targets the first valid opponent at random."
}
ability {
  id: ABILITY_HUGE_POWER
  name: "Huge Power"
  description: "Doubles own Attack stat. Boosts raw stat, not base stat."
  expanded_description: "Increases the user's Attack stat by 2x. Multiplicative with other damage boosts."
}
ability {
  id: ABILITY_POISON_POINT
  name: "Poison Point"
  description: "30% chance to poison on contact. Also works on offense."
  expanded_description: "Has a 30% chance to inflict poison on contact moves, both when attacking and being attacked."
}
ability {
  id: ABILITY_INNER_FOCUS
  name: "Inner Focus"
  description: "Blocks flinch, Intimidate, Scare. Focus Blast never misses."
  expanded_description: "Focus Blast never misses. Unaffected by flinch, Intimidate, or Scare."
}
ability {
  id: ABILITY_MAGMA_ARMOR
  name: "Magma Armor"
  description: "Frostbite-immune. Takes 30% less dmg from Water/Ice-type moves."
  expanded_description: "Immune to frostbite. Reduces damage received from Water and Ice-type moves by 30%. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_WATER_VEIL
  name: "Water Veil"
  description: "Burn-immune. Casts Aqua Ring on entry."
  expanded_description: "Uses Aqua Ring on entry, which restores 1/16 HP each turn. Grants immunity to burn status and removes burn on switching in."
}
ability {
  id: ABILITY_MAGNET_PULL
  name: "Magnet Pull"
  description: "Traps opposing Steel-types. Ghosts aren't affected."
  expanded_description: "Prevents Steel-type Pokemon from switching out while the user is present. Ghost-types are immune to this effect. Pokemon holding Shed Shell or using a pivot move such as Flip Turn can escape. Activates during the next turn if the user switches in mid battle."
}
ability {
  id: ABILITY_SOUNDPROOF
  name: "Soundproof"
  description: "Immune to sound-based moves."
  expanded_description: "Grants immunity to sound-based moves. Self-targeting sound moves are not blocked."
}
ability {
  id: ABILITY_RAIN_DISH
  name: "Rain Dish"
  description: "Heals 1/8 of max HP every turn if rain is active."
  expanded_description: "Restores 1/8 max HP at the end of each turn in rain."
}
ability {
  id: ABILITY_SAND_STREAM
  name: "Sand Stream"
  description: "Summons a sandstorm on entry. Lasts 8 turns."
  expanded_description: "Summons a Sandstorm for 8 turns (12 with Smooth Rock) on entry. Damages non-Rock/Ground/Steel types by 1/16 HP per turn. Rock-types gain a 50% Special Defense boost. Halves the effectiveness of sun related moves."
}
ability {
  id: ABILITY_PRESSURE
  name: "Pressure"
  description: "Doubles foe's PP usage. Clears stat buffs on entry."
  expanded_description: "Doubles PP usage of opposing moves and clears all positive stat stages on entry."
}
ability {
  id: ABILITY_THICK_FAT
  name: "Thick Fat"
  description: "Takes 1/2 damage from Fire-type and Ice-type attacks."
  expanded_description: "Reduces damage received from Fire and Ice-type moves by 50%. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_EARLY_BIRD
  name: "Early Bird"
  description: "Awakens twice as fast from sleep."
  expanded_description: "Allows the user to wake up from sleep twice as fast. Subtract 2 sleep turns every turn instead of 1."
}
ability {
  id: ABILITY_FLAME_BODY
  name: "Flame Body"
  description: "30% chance to burn on contact, 20% non. Also works on offense."
  expanded_description: "Contact with this Pokemon has a 30% chance to inflict burn. Non-contact has a 20% chance. Works offensively and defensively."
}
ability {
  id: ABILITY_RUN_AWAY
  name: "Run Away"
  description: "Guarantees fleeing. Raises Speed if stats lowered by an enemy."
  expanded_description: "Guarantees successful escape from wild Pokemon battles regardless of speed differences. When any of the user's stats are lowered by an opponent's move or ability, raises the user's Speed by 2 stages."
}
ability {
  id: ABILITY_KEEN_EYE
  name: "Keen Eye"
  description: "Immune to accuracy drops. Grants a 1.2x accuracy boost."
  expanded_description: "Prevents accuracy stat stage drops. All moves gain a 1.2x accuracy boost."
}
ability {
  id: ABILITY_HYPER_CUTTER
  name: "Hyper Cutter"
  description: "Enemies can't lower Atk/SpAtk. Contact moves get +1 Crit."
  expanded_description: "Hyper Cutter prevents enemies from lowering the user's Attack stat through moves or abilities. All contact moves used by this Pokemon have their critical hit rate increased by one stage."
}
ability {
  id: ABILITY_PICKUP
  name: "Pickup"
  description: "Removes all hazards on entry. Not immune to hazards."
  expanded_description: "Clears all entry hazards from your side of the field when entering battle. The Pokemon is still susceptible to hazards while clearing them."
}
ability {
  id: ABILITY_TRUANT
  name: "Truant"
  description: "Can't use attacking moves twice in a row."
  expanded_description: "Prevents consecutive attacking moves. After using an attack, the user must loaf around next turn and cannot attack. Status moves remain unaffected."
}
ability {
  id: ABILITY_HUSTLE
  name: "Hustle"
  description: "0.9x accuracy. Boosts damage by 1.4x."
  expanded_description: "Boosts the power of attacks by 1.4x but reduces their accuracy by 10%. Only affects non-status moves."
}
ability {
  id: ABILITY_CUTE_CHARM
  name: "Cute Charm"
  description: "50% chance to infatuate on contact. Also works on offense."
  expanded_description: "When hit by making contact (offensively or defensively), has a 50% chance to infatuate the attacker (cuts their Attack and Special Attack in half)."
}
ability {
  id: ABILITY_PLUS
  name: "Plus"
  description: "Deals double damage if an ally Pokémon has Minus or Plus."
  expanded_description: "Doubles the Pokemon's offensive power when partnered with an ally that has Plus or Minus."
}
ability {
  id: ABILITY_MINUS
  name: "Minus"
  description: "Deals double damage if an ally Pokémon has Minus or Plus."
  expanded_description: "Doubles the Pokemon's offensive power when partnered with an ally that has Minus or Plus."
}
ability {
  id: ABILITY_FORECAST
  name: "Forecast"
  description: "Changes form with the weather. Attacks when setting weather."
  expanded_description: "Changes form and type to match active weather. When using weather setting moves, follows up with Weather Ball (100 BP, Special, matching type with set weather). Transforms on entry, weather changes, and turn end. Unsuppressable ability that works even under Mold Breaker effects."
}
ability {
  id: ABILITY_STICKY_HOLD
  name: "Sticky Hold"
  description: "Can't lose its item."
  expanded_description: "The user's item cannot be forcibly removed or stolen."
}
ability {
  id: ABILITY_SHED_SKIN
  name: "Shed Skin"
  description: "30% chance to heal its status condition at the end of a turn."
  expanded_description: "At the end of each turn, there's a 30% chance for the user to cure status conditions afflicted on them."
}
ability {
  id: ABILITY_GUTS
  name: "Guts"
  description: "Ups Attack by 1.5x if statused."
  expanded_description: "Boosts Attack stat by 50% when suffering from any status condition. Negates the Attack drop from burn status."
}
ability {
  id: ABILITY_MARVEL_SCALE
  name: "Marvel Scale"
  description: "Ups Defense by 1.5x when statused."
  expanded_description: "Increases base Defense by 50% when afflicted with any status condition."
}
ability {
  id: ABILITY_LIQUID_OOZE
  name: "Liquid Ooze"
  description: "Draining causes harm to enemies instead of healing them."
  expanded_description: "Liquid Ooze reverses all healing effects from drain moves, causing the attacker to take damage instead. Affects Absorb, Drain Punch, Giga Drain, Leech Life, and similar draining attacks. The damage equals what would have been healed. Perfect counter to healing-based strategies."
}
ability {
  id: ABILITY_OVERGROW
  name: "Overgrow"
  description: "Boosts Grass-type moves by 1.2x, or 1.5x when under 1/3 HP."
  expanded_description: "Boosts the power of Grass-type moves by 20%, or by 50% at 1/3 HP or lower."
}
ability {
  id: ABILITY_BLAZE
  name: "Blaze"
  description: "Boosts Fire-type moves by 1.2x, or 1.5x when under 1/3 HP."
  expanded_description: "Boosts the power of Fire-type moves by 20%, or by 50% at 1/3 HP or lower."
}
ability {
  id: ABILITY_TORRENT
  name: "Torrent"
  description: "Boosts Water-type moves by 1.2x, or 1.5x when under 1/3 HP."
  expanded_description: "Boosts the power of Water-type moves by 20%, or by 50% at 1/3 HP or lower."
}
ability {
  id: ABILITY_SWARM
  name: "Swarm"
  description: "Boosts Bug-type moves by 1.2x, or 1.5x when under 1/3 HP."
  expanded_description: "Boosts the power of Bug-type moves by 20%, or by 50% at 1/3 HP or lower."
}
ability {
  id: ABILITY_ROCK_HEAD
  name: "Rock Head"
  description: "Immune to recoil damage, but not immune to Explosion/crash dmg."
  expanded_description: "Prevents all recoil damage from the user's moves and abilities. Also grants immunity to enrage recoil damage. Does not prevent crash damage or Explosion/Self-Destruct damage."
}
ability {
  id: ABILITY_DROUGHT
  name: "Drought"
  description: "Summons sun on entry. Lasts 8 turns."
  expanded_description: "Summons harsh sunlight for 8 turns (12 with Heat Rock) on entry. Boosts Fire moves by 50%, reduces Water moves by 50%. Activates extra effects on sun related moves."
}
ability {
  id: ABILITY_ARENA_TRAP
  name: "Arena Trap"
  description: "Enemies can't flee. Ghosts and ungrounded Pokémon are immune."
  expanded_description: "Prevents all non-levitating or Ghost-type foes from switching out. Pokemon holding Shed Shell or using a pivot move such as Flip Turn can escape. Activates during the next turn if the user switches in mid battle"
}
ability {
  id: ABILITY_VITAL_SPIRIT
  name: "Vital Spirit"
  description: "Can't fall asleep. Fighting-type moves heal status."
  expanded_description: "Immune to sleep. When the Pokemon uses a Fighting-type move, it heals all status conditions immediately after the move resolves. Removes sleep when gained."
}
ability {
  id: ABILITY_WHITE_SMOKE
  name: "White Smoke"
  description: "Sets Smokescreen for 3 turns on switch-in."
  expanded_description: "Sets Smokescreen on entry, lasting 3 turns. Smokescreen increases the evasiveness of your party by 25%."
}
ability {
  id: ABILITY_PURE_POWER
  name: "Pure Power"
  description: "Doubles own Sp.Atk stat. Boosts raw stat, not base stat."
  expanded_description: "Increases the user's Special Attack stat by 2x. Multiplicative with other damage boosts."
}
ability {
  id: ABILITY_SHELL_ARMOR
  name: "Shell Armor"
  description: "Immune to critical hits. Takes 20% less damage from attacks."
  expanded_description: "Incoming damage is reduced by 20% (x0.8), multiplicative with other damage reduction. Additionally, critical hits are blocked, functioning as regular hits and not activating on-crit effects like To The Bone's bleed."
}
ability {
  id: ABILITY_AIR_LOCK
  name: "Air Lock"
  description: "Cloud Nine + Air Blower."
  expanded_description: "Sets Tailwind for 3 turns and clears all weather effects on entry. Primal weathers are suppressed. Weather can still be set while the user is on the field, but will have no effect until the user switches."
}
ability {
  id: ABILITY_TANGLED_FEET
  name: "Tangled Feet"
  description: "Uses Speed as defensive stat when confused or enraged."
  expanded_description: "When the user is confused or enraged, the Pokemon uses its Speed stat instead of Defense or Special Defense for damage calculations. Choice Scarf does not affect this ability."
}
ability {
  id: ABILITY_MOTOR_DRIVE
  name: "Motor Drive"
  description: "Boosts Speed instead of being hit by Electric-type moves."
  expanded_description: "Immune to Electric-type moves, and boost Speed by 1 stage when the user is hit by them. Activates on each hit of a multihit move."
}
ability {
  id: ABILITY_RIVALRY
  name: "Rivalry"
  description: "Deals 1.25x to same gender. Takes .75x from opposite gender."
  expanded_description: "Boosts the user's damage by 25% against same-gender Pokemon and reduces damage taken by 25% from opposite-gender Pokemon. No effect with genderless Pokemon."
}
ability {
  id: ABILITY_STEADFAST
  name: "Steadfast"
  description: "Raises Speed by one stage if this Pokémon flinches."
  expanded_description: "Getting flinched raises Speed by one stage."
}
ability {
  id: ABILITY_SNOW_CLOAK
  name: "Snow Cloak"
  description: "Evasion is boosted by 1.25x under hail."
}
ability {
  id: ABILITY_GLUTTONY
  name: "Gluttony"
  description: "Eats berries early. Berries also restore 1/3 of max HP."
  expanded_description: "Berries that normally activate at 1/4 HP trigger at 1/2 HP instead. Additionally, after consuming any berry, the user recovers 1/3 of max HP. Does not include berries consumed through moves like Pluck."
}
ability {
  id: ABILITY_ANGER_POINT
  name: "Anger Point"
  description: "Getting hit raises Atk by +1. Critical hits maximize Attack."
  expanded_description: "When hit, raises the user's Attack by 1 stage or maximizes it on critical hits. Activates on each hit of a multihit move."
}
ability {
  id: ABILITY_UNBURDEN
  name: "Unburden"
  description: "Consuming its held item doubles Speed until switched out."
  expanded_description: "When consuming or losing a held item, the user's base Speed stat is multiplied by x2. Boost goes away when switching out, gaining a new item, or upon losing the ability."
}
ability {
  id: ABILITY_HEATPROOF
  name: "Heatproof"
  description: "Halves damage taken from Fire-type moves. Takes no burn damage."
  expanded_description: "Halves damage from Fire-type moves. Immune to burn damage and Attack drops from burn status."
}
ability {
  id: ABILITY_SIMPLE
  name: "Simple"
  description: "Doubles all stat changes on this Pokémon."
}
ability {
  id: ABILITY_DRY_SKIN
  name: "Dry Skin"
  description: "Water/Rain heals. Fire/Sun hurts."
  expanded_description: "The user heals 25% HP from Water-type moves and 12.5% HP each turn in rain. Takes 25% more damage from Fire moves and loses 12.5% HP per turn in sun."
}
ability {
  id: ABILITY_DOWNLOAD
  name: "Download"
  description: "Raises Atk/Sp. Atk by one stage depending on opponent."
  expanded_description: "When switching in, if the foe's Defense is higher than Special Defense, raise Special Attack by one stage. If Special Defense is higher or equal, raise Attack by one stage."
}
ability {
  id: ABILITY_IRON_FIST
  name: "Iron Fist"
  description: "Boosts the power of punching moves by 1.3x."
  expanded_description: "Boosts the power of punching moves by 30%."
}
ability {
  id: ABILITY_POISON_HEAL
  name: "Poison Heal"
  description: "Restores 1/8 of max HP after each turn if poisoned."
  expanded_description: "Restores 1/8 max HP per turn instead of taking damage when poisoned. Works with both regular poison and toxic poison. Also prevents damage from Toxic terrain."
}
ability {
  id: ABILITY_ADAPTABILITY
  name: "Adaptability"
  description: "Increases STAB from 1.5x to 2x."
  expanded_description: "Boosts STAB damage boost on moves from 1.5x to 2.0x damage."
}
ability {
  id: ABILITY_SKILL_LINK
  name: "Skill Link"
  description: "Multi-hit moves always hit the maximum number of times."
  expanded_description: "Multihit moves to always hit 5 times. For moves that only hit 3 times or Population Bomb, there will be one accuracy check for all hits instead of individual checks for each hit."
}
ability {
  id: ABILITY_HYDRATION
  name: "Hydration"
  description: "Cures own status at the end of every turn in rain."
  expanded_description: "During rain, cures all status conditions at the end of the turn."
}
ability {
  id: ABILITY_SOLAR_POWER
  name: "Solar Power"
  description: "Ups highest attacking stat by 1.5x in sun."
  expanded_description: "Boosts the Pokemon's highest attacking stat by 50% during sun."
}
ability {
  id: ABILITY_QUICK_FEET
  name: "Quick Feet"
  description: "Ups Speed by 1.5x if suffering from a status condition."
  expanded_description: "Boosts Speed stat by 50% when suffering from any status condition. Negates the Speed drop from paralysis status."
}
ability {
  id: ABILITY_NORMALIZE
  name: "Normalize"
  description: "Its moves become Normal-type, get 1.1x boost, ignore resists."
  expanded_description: "Converts all damaging moves to Normal-type and grants a 10% power boost. Normal-type moves bypass resistances, but not immunities."
}
ability {
  id: ABILITY_SNIPER
  name: "Sniper"
  description: "Critical hits have a 2.25x dmg multiplier instead of 1.5x."
  expanded_description: "Boosts critical hit damage from 1.5x to 2.25x by applying an additional 50% multiplier."
}
ability {
  id: ABILITY_MAGIC_GUARD
  name: "Magic Guard"
  description: "Only damaged by attacks."
  expanded_description: "Grants immunity to all non-attack damage sources including entry hazards, weather damage, status conditions, and recoil."
}
ability {
  id: ABILITY_NO_GUARD
  name: "No Guard"
  description: "Attacks used by and on this Pokémon bypass accuracy checks."
  expanded_description: "Guarantees hits for all moves used by and against the user."
}
ability {
  id: ABILITY_STALL
  name: "Stall"
  description: "Takes 30% less damage if it hasn't moved yet."
  expanded_description: "Reduces damage by 30% if the user has not moved yet. Multiplicative with other damage reduction sources. Works when the user switches in mid-turn."
}
ability {
  id: ABILITY_TECHNICIAN
  name: "Technician"
  description: "Moves with 60 BP or less get a 1.5x boost."
  expanded_description: "Boosts moves with 60 BP or less by 1.5x. Does not boost moves with 60 BP or less if they potentially can have more than 60 BP, such as Revenge or Venoshock."
}
ability {
  id: ABILITY_LEAF_GUARD
  name: "Leaf Guard"
  description: "Cures own status at the end of every turn in sun."
  expanded_description: "During sun, cures all status conditions at the end of the turn."
}
ability {
  id: ABILITY_KLUTZ
  name: "Klutz"
  description: "Own held item has no effect. Mega Stones are unaffected."
  expanded_description: "Disables all held item effects. Items can still be knocked off or stolen but give no benefits. Item-based moves like Fling fail. Mega Stones bypass this restriction."
}
ability {
  id: ABILITY_MOLD_BREAKER
  name: "Mold Breaker"
  description: "Moves hit through abilities. Also affects innates."
  expanded_description: "Allows moves to ignore the target's abilities and innates that interfere with effects or reduce damage. Does not bypass abilities that modify base stats such as Grass Pelt."
}
ability {
  id: ABILITY_SUPER_LUCK
  name: "Super Luck"
  description: "Raises critical-hit ratio of own moves by +1."
  expanded_description: "Adds +1 to the critical hit stage of all the Pokemon's damaging moves."
}
ability {
  id: ABILITY_AFTERMATH
  name: "Aftermath"
  description: "100BP Explosion / Outburst when KOed. Explosion moves flinch."
  expanded_description: "Uses a 100BP Explosion (if Attack is higher) or Outburst (if Special Attack is higher) when knocked out. Using explosion moves will always flinch the target."
}
ability {
  id: ABILITY_ANTICIPATION
  name: "Anticipation"
  description: "Senses Super-effective moves. Dodges one Super-effective hit."
  expanded_description: "Alerts the Pokemon when facing opponents with super-effective moves on switch-in. Dodge the first super effective hit received in battle."
}
ability {
  id: ABILITY_FOREWARN
  name: "Forewarn"
  description: "Casts an 80 BP Future Sight on entry."
  expanded_description: "Casts an 80 BP Future Sight on the opposing Pokemon when switching in. Strikes 2 turns later, bypassing substitutes and other protections. The attack cannot miss once initiated and ignores accuracy checks. This cannot target the same Pokemon twice."
}
ability {
  id: ABILITY_UNAWARE
  name: "Unaware"
  description: "Ignores foes' stat changes, both positive and negative ones."
  expanded_description: "Ignores all the foes' stat stage changes during damage calculations."
}
ability {
  id: ABILITY_TINTED_LENS
  name: "Tinted Lens"
  description: "Attacks deal double damage if resisted."
  expanded_description: "Doubles damage when attacking into resistances. If a move would be resisted (0.5x damage or less), the damage is multiplied by 2x."
}
ability {
  id: ABILITY_FILTER
  name: "Filter"
  description: "Takes 35% less damage from Super-effective moves."
  expanded_description: "Reduces damage from super-effective attacks by 35%. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_SLOW_START
  name: "Slow Start"
  description: "Halves Offenses and Speed during the first 5 turns out."
  expanded_description: "Halves Attack, Special Attack, and Speed for the first 5 turns after switching in. The turn counter resets each time the Pokemon switches out."
}
ability {
  id: ABILITY_SCRAPPY
  name: "Scrappy"
  description: "Normal/Fighting can hit Ghosts. Immune to Intimidate/Scare."
  expanded_description: "The user can land Normal and Fighting-type moves on Ghost-types for neutral damage. Grants immunity to Intimidate and Scare."
}
ability {
  id: ABILITY_STORM_DRAIN
  name: "Storm Drain"
  description: "Redirects Water moves. Absorbs them, ups highest Atk."
  expanded_description: "The user draws in Water-type moves and gains immunity to them. Additionally, Water-type moves boost the highest attacking stat of the user by one stage."
}
ability {
  id: ABILITY_ICE_BODY
  name: "Ice Body"
  description: "Heals 1/8 of max HP every turn in hail."
  expanded_description: "Restores 1/8 max HP at the end of each turn in hail. Also grants immunity to hail damage."
}
ability {
  id: ABILITY_SOLID_ROCK
  name: "Solid Rock"
  description: "Takes 35% less damage from Super-effective moves."
  expanded_description: "Reduces damage from super-effective attacks by 35%. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_SNOW_WARNING
  name: "Snow Warning"
  description: "Summons hail on entry. Lasts 8 turns."
  expanded_description: "Summons hailstorm for 8 turns (12 with Icy Rock) on entry. Damages non-Ice types by 1/16 HP per turn. Boosts the Defense stat of Ice-type Pokemon by 50%. Halves the effectiveness of sun related moves."
}
ability {
  id: ABILITY_HONEY_GATHER
  name: "Honey Gather"
  description: "Has a 50% chance to find Honey each turn."
  expanded_description: "Has a 50% chance to get Honey each turn if it had no item. Honey heals 1/16 HP per turn and can be eaten in a pinch to heal 1/4 HP. Works even if the user didn't start with Honey as its item."
}
ability {
  id: ABILITY_FRISK
  name: "Frisk"
  description: "Checks foes' item and disables their items for two turns."
  expanded_description: "Upon entering battle, reveals the opponents' items and prevents them from working for 2 turns. Does not prevent Mega Stones and other similar items from working."
}
ability {
  id: ABILITY_RECKLESS
  name: "Reckless"
  description: "Moves causing recoil damage deal 1.2x more damage."
  expanded_description: "Increases the damage of moves that cause recoil by 20%. This bonus also applies when moves gain recoil through other means, such as madness or abilities."
}
ability {
  id: ABILITY_MULTITYPE
  name: "Multitype"
  description: "Held Plate item decides holder's type."
  expanded_description: "The user changes form based of the type of Plate they are currently holding. Plates cannot be removed, and Multitype cannot be overridden, suppressed, swapped, or copied in any way."
}
ability {
  id: ABILITY_FLOWER_GIFT
  name: "Flower Gift"
  description: "Increases the party's SpAtk and SpDef by 1.5x in Sun."
  expanded_description: "During sun, boost base Special Attack and Special Defense by 50% for this Pokemon and all allies."
}
ability {
  id: ABILITY_BAD_DREAMS
  name: "Bad Dreams"
  description: "Sleeping Pokémon lose 1/4 of max HP at the end of each turn."
  expanded_description: "All sleeping opponents lose 25% of their max HP at the end of each turn."
}
ability {
  id: ABILITY_PICKPOCKET
  name: "Pickpocket"
  description: "Steals the foe's held item on contact."
  expanded_description: "The user steals the target's held item on contact if they are currently holding no item. Does not work with Mega Stones and other similar items."
}
ability {
  id: ABILITY_SHEER_FORCE
  name: "Sheer Force"
  description: "Exchanges added effects on its moves for 1.3x more power."
  expanded_description: "Removes most beneficial secondary effects after landing attacks in exchange for a 1.3x boost. Notably prevents Life Orb recoil when using these moves. Removable effects include reducing the target's stats, increasing the user's stats, inflicting status on a target and flinching."
}
ability {
  id: ABILITY_CONTRARY
  name: "Contrary"
  description: "Stat raises turn into stat drops for this Pokémon and vice versa."
  expanded_description: "Reverses all stat changes affecting this Pokemon. Works with self-inflicted changes."
}
ability {
  id: ABILITY_UNNERVE
  name: "Unnerve"
  description: "Foes can't use consumable items."
  expanded_description: "Prevents all opposing Pokemon from consuming held items."
}
ability {
  id: ABILITY_DEFIANT
  name: "Defiant"
  description: "Raises Attack by two stages if stats are lowered by an enemy."
  expanded_description: "When the user has their stats lowered by another Pokemon, they raise their Attack by 2 stages."
}
ability {
  id: ABILITY_DEFEATIST
  name: "Defeatist"
  description: "Halves Atk and Sp. Atk stats if user is below 1/3 of max HP."
  expanded_description: "Halves both Attack and Special Attack stats when HP drops below 33% of maximum. Deactivates after healing above this threshold."
}
ability {
  id: ABILITY_CURSED_BODY
  name: "Cursed Body"
  description: "30% chance to disable moves if enemy makes contact."
  expanded_description: "The user has a 30% chance to disable the attacker's move for 4 turns when hit by contact moves. The disabled move cannot be selected until the effect wears off."
}
ability {
  id: ABILITY_HEALER
  name: "Healer"
  description: "30% chance to heal user or ally's status at the end of each turn."
  expanded_description: "Gives a 30% chance to cure status conditions at the end of each turn for both the user and their ally if they are out in a double battle. Makes 2 separate checks for each Pokemon."
}
ability {
  id: ABILITY_FRIEND_GUARD
  name: "Friend Guard"
  description: "Reduces damage that ally takes by 25% in double battles."
  expanded_description: "In a double battle, the user's ally receives 25% less damage. Multiplicative with other damage reduction sources."
}
ability {
  id: ABILITY_WEAK_ARMOR
  name: "Weak Armor"
  description: "If hit by a contact move: -1 Defense and +2 Speed."
  expanded_description: "When hit by a contact move, raises the user's Speed by 2 stages and lowers their defense by 1 stage. Activates on each hit of a multihit move."
}
ability {
  id: ABILITY_HEAVY_METAL
  name: "Heavy Metal"
  description: "Take half damage from Ghost/Dark and doubles user's weight."
  expanded_description: "Takes half damage from Ghost and Dark-type attacks. Doubles the Pokemon's weight, which affects some moves."
}
ability {
  id: ABILITY_LIGHT_METAL
  name: "Light Metal"
  description: "Boosts Speed by 1.3x and halves this Pokémon's weight."
  expanded_description: "Light Metal halves the Pokemon's weight and boosts their Speed stat by 30%. Makes weight-based attacks such as Low Kick deal less damage against this Pokemon. However, it also decreases damage from the user's Heavy Slam and similar weight-based moves."
}
ability {
  id: ABILITY_MULTISCALE
  name: "Multiscale"
  description: "At full HP, halves damage taken from attacks"
  expanded_description: "Reduces all incoming damage by 50% when the Pokemon is at max HP. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_TOXIC_BOOST
  name: "Toxic Boost"
  description: "Ups Atk by 1.5x if poisoned. Immune to Poison status damage."
  expanded_description: "Increases the Pokemon's Attack stat by 50% when poisoned (regular or badly poisoned). Immediately applies poison to user when in Toxic Terrain, regardless of them being grounded or not. Nullifies poison damage."
}
ability {
  id: ABILITY_FLARE_BOOST
  name: "Flare Boost"
  description: "Ups Sp. Atk by 1.5x if burned. Ignites in fog."
  expanded_description: "Raises the Pokemon's Special Attack stat by 50% when burned. Negates burn damage. Immediately applies burn to self in fog."
}
ability {
  id: ABILITY_HARVEST
  name: "Harvest"
  description: "50% chance to recycle a used Berry every turn, 100% in sun."
  expanded_description: "50% chance to restore berry on turn end, 100% in sun. Includes berries that were used for Fling, Natural Gift, or eaten."
}
ability {
  id: ABILITY_TELEPATHY
  name: "Telepathy"
  description: "Protects team from friendly fire."
  expanded_description: "Protects the Pokemon from all damage-dealing moves used by its allies in double battles."
}
ability {
  id: ABILITY_MOODY
  name: "Moody"
  description: "Sharply raises one stat and lowers another each turn."
  expanded_description: "At the end of each turn, randomly selects one stat to raise by 2 stages and another different stat to lower by 1 stage."
}
ability {
  id: ABILITY_OVERCOAT
  name: "Overcoat"
  description: "Blocks weather dmg and powders. Takes -20% special damage."
  expanded_description: "Provides immunity to weather damage from Sandstorm and Hail, and blocks all powder moves including Sleep Powder, Stun Spore, Poison Powder, Spore, Cotton Spore, Rage Powder, Powder, and Magic Powder. Also reduces incoming special damage by 20%. Multiplicative with other damage reduction sources."
}
ability {
  id: ABILITY_POISON_TOUCH
  name: "Poison Touch"
  description: "30% chance to poison on contact. Also works on offense."
  expanded_description: "Has a 30% chance to inflict poison on contact moves, both when attacking and being attacked."
}
ability {
  id: ABILITY_REGENERATOR
  name: "Regenerator"
  description: "Heals 1/3 of max HP upon switching out."
  expanded_description: "Restores 33% of maximum HP when switching out. This heal is not blocked by Heal Block."
}
ability {
  id: ABILITY_BIG_PECKS
  name: "Big Pecks"
  description: "Boosts the power of contact moves by 1.3x."
  expanded_description: "Boosts the power of contact moves by 30%."
}
ability {
  id: ABILITY_SAND_RUSH
  name: "Sand Rush"
  description: "This Pokémon's Speed gets a 1.5x boost in a sandstorm."
  expanded_description: "Boosts the Pokemon's Speed stat by 50% in sand. Also grants immunity to sandstorm damage."
}
ability {
  id: ABILITY_WONDER_SKIN
  name: "Wonder Skin"
  description: "Blocks most damage boosting and multihit abilities."
  expanded_description: "Immune to all damage boosting ability effects from opponents, other than Parental Bond, Familia Bond, and Multi-Headed."
}
ability {
  id: ABILITY_ANALYTIC
  name: "Analytic"
  description: "Attacks get a 1.3x power boost if it moves last."
  expanded_description: "When the user moves after the target, boosts attack power by 30%."
}
ability {
  id: ABILITY_ILLUSION
  name: "Illusion"
  description: "Appears as last party slot and boosts power by 1.3x until hit."
  expanded_description: "Makes the Pokemon appear as the last alive party member. Boosts the user's damage by 30% until the illusion breaks."
}
ability {
  id: ABILITY_IMPOSTER
  name: "Imposter"
  description: "Transforms into the foe on entry."
  expanded_description: "Transforms the Pokemon into the opponent upon switching in. Copies their appearance, stats (minus HP), types, abilities, moves, and stat changes. Each copied move has 5 PP. Cannot transform if the target has Substitute, is already transformed, has Illusion active, or is semi-invulnerable."
}
ability {
  id: ABILITY_INFILTRATOR
  name: "Infiltrator"
  description: "Own moves bypass Substitutes and damage reduction screens."
  expanded_description: "Allows moves to bypass the effects of screens, Safeguard, Mist, and Substitute."
}
ability {
  id: ABILITY_MUMMY
  name: "Mummy"
  description: "If hit, makes the attacker's ability Mummy."
  expanded_description: "When the user receives a contact move from another Pokemon who does not have this ability, it replaces their current ability with Mummy."
}
ability {
  id: ABILITY_MOXIE
  name: "Moxie"
  description: "Dealing a KO raises Attack by one stage."
  expanded_description: "Boosts the user's Attack by one stage whenever it knocks out an opponent with a direct hit."
}
ability {
  id: ABILITY_JUSTIFIED
  name: "Justified"
  description: "Boosts highest attack instead of being hit by Dark-type moves."
  expanded_description: "Immune to Dark-type moves, and boost Attack or Special Attack by 1 stage when the user is hit by them, based on whichever stat is higher."
}
ability {
  id: ABILITY_RATTLED
  name: "Rattled"
  description: "If hit by Bug, Dark or Ghost move, or flinches: +1 Speed."
  expanded_description: "Boosts Speed by one stage when hit by Bug, Dark, or Ghost-type moves or when the user flinches. Activates multiple times against multihit moves."
}
ability {
  id: ABILITY_MAGIC_BOUNCE
  name: "Magic Bounce"
  description: "Bounces back the effect of status moves to their user."
  expanded_description: "Reflects most status moves back to the user before they can take effect. The bounced move targets the original user with no additional accuracy check. Does not reflect moves that were already reflected."
}
ability {
  id: ABILITY_SAP_SIPPER
  name: "Sap Sipper"
  description: "Redirects Grass moves. Absorbs them, ups highest Atk."
  expanded_description: "Immune to Grass-type moves, and boost highest attacking stat by 1 stage when the user is hit by them."
}
ability {
  id: ABILITY_PRANKSTER
  name: "Prankster"
  description: "Status moves have +1 priority but fail on opposing Dark-types."
  expanded_description: "Status moves gain +1 priority. Status moves fail when directly targeting opposing Dark-type Pokemon."
}
ability {
  id: ABILITY_SAND_FORCE
  name: "Sand Force"
  description: "Ups highest attacking stat by 1.5x in sand."
  expanded_description: "Boosts the Pokemon's highest attacking stat by 50% in sand. Immune to sandstorm damage."
}
ability {
  id: ABILITY_IRON_BARBS
  name: "Iron Barbs"
  description: "Enemies lose 1/8 of max HP if they use a contact move."
}
ability {
  id: ABILITY_ZEN_MODE
  name: "Zen Mode"
  description: "Transforms into Zen Mode on entry until end of battle."
  expanded_description: "Triggers form change upon battle entry."
}
ability {
  id: ABILITY_VICTORY_STAR
  name: "Victory Star"
  description: "Gives 1.2x accuracy boost to its own and its allies' moves."
  expanded_description: "Boosts the user's and their ally's accuracy by 1.2x when active in a double battle."
}
ability {
  id: ABILITY_TURBOBLAZE
  name: "Turboblaze"
  description: "Moves hit through abilities. Adds Fire type to itself."
  expanded_description: "Allows moves to ignore the target's abilities and innates that interfere with effects or reduce damage. Does not bypass abilities that modify base stats such as Grass Pelt. Adds Fire to the user's typing. Retains Fire typing even upon losing the ability, going away only when switching out."
}
ability {
  id: ABILITY_TERAVOLT
  name: "Teravolt"
  description: "Moves hit through abilities. Adds Electric type to itself."
  expanded_description: "Allows moves to ignore the target's abilities and innates that interfere with effects or reduce damage. Does not bypass abilities that modify base stats such as Grass Pelt. Adds Electric to the user's typing. Retains Electric typing even upon losing the ability, going away only when switching out."
}
ability {
  id: ABILITY_AROMA_VEIL
  name: "Aroma Veil"
  description: "Protects team from infatuation, heal block, and disabling."
  expanded_description: "Protects the user and allies from infatuation, heal block effects, and disabling moves including Disable, Taunt, Encore, and Torment."
}
ability {
  id: ABILITY_FLOWER_VEIL
  name: "Flower Veil"
  description: "Protects Grass-type allies from status and stat drops."
  expanded_description: "Prevents all status conditions and stat reductions for Grass-type allies."
}
ability {
  id: ABILITY_CHEEK_POUCH
  name: "Cheek Pouch"
  description: "This ability has no effect."
  expanded_description: "No effect."
}
ability {
  id: ABILITY_PROTEAN
  name: "Protean"
  description: "Changes type depending on the move it's about to use."
  expanded_description: "Before each attack, the user overrides their type to match the move's type.  Activates once per turn."
}
ability {
  id: ABILITY_FUR_COAT
  name: "Fur Coat"
  description: "Halves damage taken by Physical moves. Does NOT double Defense."
  expanded_description: "Halves all incoming Attack damage. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_MAGICIAN
  name: "Magician"
  description: "Steals the foe's held item after using a non-contact move."
  expanded_description: "The user steals the target's held item when landing a non-contact move if they are currently holding no item. Does not work with Mega Stones and other similar items."
}
ability {
  id: ABILITY_BULLETPROOF
  name: "Bulletproof"
  description: "Immune to projectile, ball, or bomb-based moves."
  expanded_description: "Provides immunity to ball, bomb, and projectile moves. Includes Acid Spray, Rock Wrecker, Pollen Puff, and Barrage."
}
ability {
  id: ABILITY_COMPETITIVE
  name: "Competitive"
  description: "Raises Sp. Atk by two stages if stats are lowered by an enemy."
  expanded_description: "When the user has their stats lowered by another Pokemon, they raise their Special Attack by 2 stages."
}
ability {
  id: ABILITY_STRONG_JAW
  name: "Strong Jaw"
  description: "Boosts the power of bite/fang moves by 1.3x."
  expanded_description: "Boosts the power of biting and fang moves by 30%."
}
ability {
  id: ABILITY_REFRIGERATE
  name: "Refrigerate"
  description: "Normal moves become Ice. Ice moves are empowered."
  expanded_description: "Changes the user's Normal-type moves to Ice-type. If the user is Ice-type its Ice-type moves have a 10% frostbite chance, otherwise it gains Ice STAB."
}
ability {
  id: ABILITY_SWEET_VEIL
  name: "Sweet Veil"
  description: "This Pokémon and its ally are immune to sleep."
  expanded_description: "Provides sleep immunity to both the user and their ally in double battles."
}
ability {
  id: ABILITY_STANCE_CHANGE
  name: "Stance Change"
  description: "Turns into Blade or Shield form depending on move used."
  expanded_description: "Changes Aegislash's form based on moves used. Shield form switches to Blade when using damaging moves. Blade switches to Shield with King's Shield. Redux forms swap between physical/special based on move type. Unsuppressable. Form changes occur before attacks execute."
}
ability {
  id: ABILITY_GALE_WINGS
  name: "Gale Wings"
  description: "Flying-type moves get +1 priority at full HP."
  expanded_description: "Grants +1 priority to Flying-type moves when at full HP."
}
ability {
  id: ABILITY_MEGA_LAUNCHER
  name: "Mega Launcher"
  description: "Boosts Beam/Pump/Cannon/Shot/ Gun/Pulse, etc. moves by 1.3x."
  expanded_description: "Boosts pulse, beam, ball, and aura moves by 30%."
}
ability {
  id: ABILITY_GRASS_PELT
  name: "Grass Pelt"
  description: "Boosts Defense by 50% in Grassy Terrain."
  expanded_description: "Boosts the user's Defense stat by 50% when in Grassy Terrain."
}
ability {
  id: ABILITY_SYMBIOSIS
  name: "Symbiosis"
  description: "Passes own item to its ally if said ally consumes its item."
  expanded_description: "Transfers the holder's item to an ally immediately after that ally consumes or uses up their held item."
}
ability {
  id: ABILITY_TOUGH_CLAWS
  name: "Tough Claws"
  description: "Boosts the power of contact moves by 1.3x."
  expanded_description: "Contact moves are boosted by 30%."
}
ability {
  id: ABILITY_PIXILATE
  name: "Pixilate"
  description: "Normal moves become Fairy. Fairy moves are empowered."
  expanded_description: "Changes the user's Normal-type moves to Fairy-type. If the user is Fairy-type its Fairy-type moves have a 10% infatuate chance, otherwise it gains Fairy STAB."
}
ability {
  id: ABILITY_GOOEY
  name: "Gooey"
  description: "Lowers Speed of enemies that make contact with this Pokémon."
  expanded_description: "When the user is hit by a contact move, the attacker reduces their Speed by one stage. Activates multiple times against multihit moves."
}
ability {
  id: ABILITY_AERILATE
  name: "Aerilate"
  description: "Normal moves become Flying. Flying moves are empowered."
  expanded_description: "Changes the user's Normal-type moves to Flying-type. If the user is Flying-type its Flying-type moves are 10% faster, otherwise it gains Flying STAB."
}
ability {
  id: ABILITY_PARENTAL_BOND
  name: "Parental Bond"
  description: "Moves hit twice. 1st hit at 100% power, 2nd hit at 25%."
  expanded_description: "Makes all attacks hit twice in succession. The first hit deals 100%, while the second hit deals 25%. Each hit rolls secondary effects independently (except flinch). Bypasses Fort Knox/Wonder Skin."
}
ability {
  id: ABILITY_DARK_AURA
  name: "Dark Aura"
  description: "Boosts Dark moves by 1.33x for all while this Pokémon is out."
  expanded_description: "All Dark-type moves for the user, their allies, and the opponent get a 1.33x boost. Boost is reversed by Aura Break."
}
ability {
  id: ABILITY_FAIRY_AURA
  name: "Fairy Aura"
  description: "Boosts Fairy moves by 1.33x for all while this Pokémon is out."
  expanded_description: "All Fairy-type moves for the user, their allies, and the opponent get a 1.33x boost. Boost is reversed by Aura Break."
}
ability {
  id: ABILITY_AURA_BREAK
  name: "Aura Break"
  description: "Cancels aura abilities and makes them 25% weaker instead."
  expanded_description: "Causes Dark Aura and Fairy Aura to reduce their respective type moves by 25% instead of boosting them by 33%."
}
ability {
  id: ABILITY_PRIMORDIAL_SEA
  name: "Primordial Sea"
  description: "Heavy Rain until switched out. Fire-type moves are unusable."
  expanded_description: "Creates Heavy Rain that lasts until user switches. Completely nullifies all damaging Fire moves. Water moves gain 50% boost. Cannot be overridden except by other primal weather. Activates extra effects on rain related moves. Halves the effectiveness of sun related moves."
}
ability {
  id: ABILITY_DESOLATE_LAND
  name: "Desolate Land"
  description: "Intense Sun until switched out. Water-type moves are unusable."
  expanded_description: "Creates Extremely Harsh Sunlight lasting until user switches. Completely nullifies all damaging Water moves. Fire moves gain 50% boost. Cannot be overridden except by other primal weather. Activates extra effects on sun related moves."
}
ability {
  id: ABILITY_DELTA_STREAM
  name: "Delta Stream"
  description: "Strong Winds until switched out. Weather-based moves not usable."
  expanded_description: "Creates Strong Winds lasting until user switches. Reduces super-effective damage to all active Flying-types to neutral. Blocks all weather-based moves from hitting opponents. Cannot be overridden except by other primal weather."
}
ability {
  id: ABILITY_STAMINA
  name: "Stamina"
  description: "Boosts Defense by +1 when hit. Critical hits maximize Defense."
  expanded_description: "When hit, raises the user's Defense by 1 stage or maximizes it on critical hits. Activates on each hit of a multihit move."
}
ability {
  id: ABILITY_WIMP_OUT
  name: "Wimp Out"
  description: "At 1/2 of max HP or below, instantly switches out."
  expanded_description: "When the Pokemon receives damage and its HP drops to 50% or below for the first time in battle, it switches out to safety. Activates on the last hit of multihit moves."
}
ability {
  id: ABILITY_EMERGENCY_EXIT
  name: "Emergency Exit"
  description: "At 1/2 of max HP or below, instantly switches out."
  expanded_description: "When the Pokemon receives damage and its HP drops to 50% or below for the first time in battle, it switches out to safety. Activates on the last hit of multihit moves."
}
ability {
  id: ABILITY_WATER_COMPACTION
  name: "Water Compaction"
  description: "Takes 1/2 dmg from Water-type moves. +2 Def when hit by those."
  expanded_description: "Reduces damage from Water-type moves by 50% and raises Defense by 2 stages when hit by Water moves. Multiplicative with other sources of damage reduction. Defense boost applies after the hit lands. Activates on each hit of a multihit move."
}
ability {
  id: ABILITY_MERCILESS
  name: "Merciless"
  description: "Always crits slowed, poisoned, paralyzed, or bleeding foes."
  expanded_description: "Guarantees critical hits against targets who are poisoned, paralyzed, bleeding, or have their speed lowered."
}
ability {
  id: ABILITY_SHIELDS_DOWN
  name: "Shields Down"
  description: "At 1/2 of max HP or below, transforms into Core form."
  expanded_description: "Transforms Minior from Meteor Form to Core Form when HP drops to 50% or below. In Meteor Form, grants immunity to all status conditions. When using Shell Smash, immediately transforms to Core Form regardless of current HP. Cannot revert to Meteor Form once transformed during battle."
}
ability {
  id: ABILITY_STAKEOUT
  name: "Stakeout"
  description: "Deals double damage to opponents being switched in."
  expanded_description: "Deals double damage to opponents that just switched in. Only works right after they switch in for 1 turn."
}
ability {
  id: ABILITY_WATER_BUBBLE
  name: "Water Bubble"
  description: "Halves Fire dmg taken. Doubles Water dmg dealt. No burns."
  expanded_description: "Doubles the power of Water-type moves and reduces Fire-type damage taken by 50%. Also provides complete immunity to burns, removing existing burns upon gaining the ability."
}
ability {
  id: ABILITY_STEELWORKER
  name: "Steelworker"
  description: "Normal moves become Steel. Steel resists Ghost and Dark."
  expanded_description: "Changes the user's Normal-type moves to Steel-type. If the user is Steel-type it resists Ghost and Dark, otherwise it gains Steel STAB."
}
ability {
  id: ABILITY_BERSERK
  name: "Berserk"
  description: "Boosts highest attack by +1 when at 1/2 of max HP or lower."
  expanded_description: "Berserk activates when the Pokemon drops to half HP or below from an opposing attack, boosting its highest attacking stat by one stage. Includes stat stages to determine which gets boosted. Triggers only once per battle. Other damage sources that bring you to half HP or below will not activate it."
}
ability {
  id: ABILITY_SLUSH_RUSH
  name: "Slush Rush"
  description: "This Pokémon's Speed gets a 1.5x boost in hail."
  expanded_description: "Boosts the Pokemon's Speed stat by 50% during hail. Also grants immunity to hail damage."
}
ability {
  id: ABILITY_LONG_REACH
  name: "Long Reach"
  description: "Physical moves get a 1.2x bonus and don't make contact."
  expanded_description: "Long Reach prevents the user from making contact with targets when using contact moves. Additionally, physical moves receive a 1.2x damage boost."
}
ability {
  id: ABILITY_LIQUID_VOICE
  name: "Liquid Voice"
  description: "Sound moves get a 1.2x boost and become Water if Normal."
  expanded_description: "Liquid Voice converts Normal-type sound moves to Water-type and boosts them by 20%."
}
ability {
  id: ABILITY_TRIAGE
  name: "Triage"
  description: "Moves that restore HP gain +3 priority."
  expanded_description: "Triage grants +3 priority to most HP healing moves. Includes draining moves like Giga Drain, and delayed healing moves like Wish. Does not work with Aqua Ring, Grassy Terrain, Ingrain, Leech Seed, Pain Split, Present, or Pollen Puff."
}
ability {
  id: ABILITY_GALVANIZE
  name: "Galvanize"
  description: "Normal moves become Electric. Electric moves are empowered."
  expanded_description: "Changes the user's Normal-type moves to Electric-type. If the user is Electric-type its Electric-type moves have a 10% chance to paralyze, otherwise it gains Electric STAB."
}
ability {
  id: ABILITY_SURGE_SURFER
  name: "Surge Surfer"
  description: "If Electric Terrain is active, gets a 1.5x Speed boost."
  expanded_description: "Surge Surfer boosts the Pokemon's Speed by 50% when Electric Terrain is active. The boost applies immediately and disappears when it ends."
}
ability {
  id: ABILITY_SCHOOLING
  name: "Schooling"
  description: "If Lv. 20 or more: changes into School form until 1/4 HP or less."
  expanded_description: "When at level 20 or above, transforms into School Form. Reverts to Solo Form when HP drops to 25% or less. This form change triggers automatically upon entry and at end of each turn. Cannot be overridden, suppressed, swapped, or copied in any way."
}
ability {
  id: ABILITY_DISGUISE
  name: "Disguise"
  description: "Protects once against an attack. Restores protection in fog."
  expanded_description: "Disguise blocks the first damaging move that hits the Pokemon and changes its form after. Only non-status moves are blocked. In fog, the disguise is restored immediately once per switch in, or when fog is set again."
}
ability {
  id: ABILITY_BATTLE_BOND
  name: "Battle Bond"
  description: "Transforms into Battle Bond form after dealing a KO."
  expanded_description: "Battle Bond immediately triggers a form change when this Pokemon deals the finishing blow to an opposing Pokemon. Cannot be copied."
}
ability {
  id: ABILITY_POWER_CONSTRUCT
  name: "Power Construct"
  description: "At 1/2 of max HP or below, transforms into Complete form."
  expanded_description: "Power Construct transforms Zygarde 50% or 10% forms into Complete form when HP drops to 50% or below at the end of any turn. Complete form has massive 216 HP (doubled from 108), making it an extremely bulky tank. The transformation is permanent for the battle and cannot be suppressed."
}
ability {
  id: ABILITY_CORROSION
  name: "Corrosion"
  description: "Poison is super effective vs Steel. Can poison any type."
  expanded_description: "Poison-type moves become super effective against Steel-type Pokemon. Additionally, this Pokemon can inflict poison status on any type."
}
ability {
  id: ABILITY_COMATOSE
  name: "Comatose"
  description: "Can move, but is always asleep. Immune to status conditions."
  expanded_description: "Comatose considers the user as asleep for moves and statuses. The Pokemon can move normally and gains immunity to all status conditions. Cannot be copied or suppressed. Rest fails when used."
}
ability {
  id: ABILITY_QUEENLY_MAJESTY
  name: "Queenly Majesty"
  description: "Protects itself and ally from priority moves."
  expanded_description: "Queenly Majesty prevents the user and its ally from being targeted by priority moves with priority higher than 0."
}
ability {
  id: ABILITY_INNARDS_OUT
  name: "Innards Out"
  description: "If KO'd, deals as much damage as what the fatal attack dealt."
  expanded_description: "Innards Out activates when the Pokemon is knocked out by an opponent's attack. It inflicts the same amount of damage the fatal attack dealt back to the attacker. Cannot affect attackers protected by Magic Guard."
}
ability {
  id: ABILITY_DANCER
  name: "Dancer"
  description: "Copies dance moves used by others."
  expanded_description: "When any Pokemon on the field uses a dance move, this Pokemon immediately uses the same move after. Triggers once per move."
}
ability {
  id: ABILITY_BATTERY
  name: "Battery"
  description: "Grants a 1.3x power boost to ally's Special attacks."
  expanded_description: "Battery provides a 30% boost to ally Pokemon's Special attacks in double battles. Does not affect the user's own moves."
}
ability {
  id: ABILITY_FLUFFY
  name: "Fluffy"
  description: "Halves contact damage taken. 2x weak to Fire-type moves."
  expanded_description: "Fluffy reduces damage from contact moves by 50%. Fire-type moves to deal double damage to the user. Multiplicative with other forms of damage reduction."
}
ability {
  id: ABILITY_DAZZLING
  name: "Dazzling"
  description: "Protects itself and ally from priority moves."
  expanded_description: "Dazzling blocks all priority moves from opponents targeting the user or allies."
}
ability {
  id: ABILITY_SOUL_HEART
  name: "Soul-Heart"
  description: "KOs dealt anywhere on the field raise Sp. Atk by one stage."
  expanded_description: "Soul-Heart raises Special Attack by one stage when any Pokemon faints on the battlefield, including allies and enemies."
}
ability {
  id: ABILITY_TANGLING_HAIR
  name: "Tangling Hair"
  description: "Lowers Speed of enemies that make contact with this Pokémon."
  expanded_description: "When the user is hit by a contact move, the attacker reduces their Speed by one stage. Activates multiple times against multihit moves."
}
ability {
  id: ABILITY_RECEIVER
  name: "Receiver"
  description: "In Double Battles, copies its fainting partner's ability."
  expanded_description: "Receiver copies a fainted ally's ability, replacing Receiver. Persists until switched out."
}
ability {
  id: ABILITY_POWER_OF_ALCHEMY
  name: "Power of Alchemy"
  description: "Transmutes berries on entry. Transmutes items when lost."
  expanded_description: "Upon entry, transmutes all opposing Berries into Black Sludge. When any Pokemon loses an item during battle, it gets replaced by Black Sludge. If Black Sludge is removed, it gets replaced by Big Nugget."
}
ability {
  id: ABILITY_BEAST_BOOST
  name: "Beast Boost"
  description: "Dealing a KO raises highest calculated stat by one stage."
  expanded_description: "Beast Boost raises the user's highest calculated stat by one stage each time it KOs an opponent. The stat raised is determined by comparing the raw stat without current modifiers such as stat raises."
}
ability {
  id: ABILITY_RKS_SYSTEM
  name: "RKS System"
  description: "Held Memory determines its type. Also has Protean + Adaptability."
  expanded_description: "RKS System changes the user's form based on its held Memory disc. Before each attack, the user overrides their type to match the move's type. Boosts STAB from 1.5x to 2.0x damage."
}
ability {
  id: ABILITY_ELECTRIC_SURGE
  name: "Electro Surge"
  description: "Casts Electric Terrain on entry. Lasts 8 turns."
  expanded_description: "Creates Electric Terrain for 8 turns (12 with Terrain Extender) upon entry. Grounded Pokemon cannot fall asleep and Electric moves gain 30% power boost. Overrides other terrains when activated."
}
ability {
  id: ABILITY_PSYCHIC_SURGE
  name: "Psychic Surge"
  description: "Casts Psychic Terrain on entry. Lasts 8 turns."
  expanded_description: "Creates Psychic Terrain for 8 turns (12 with Terrain Extender) on entry. Grounded Pokemon are immune to priority moves from opponents. Psychic moves gain 30% power boost. Expanding Force hits all foes with increased power. Nature Power becomes Psychic. Overrides other existing terrains."
}
ability {
  id: ABILITY_MISTY_SURGE
  name: "Misty Surge"
  description: "Casts Misty Terrain on entry. Lasts 8 turns."
  expanded_description: "Creates Misty Terrain on entry, lasting 8 turns (12 with Terrain Extender). Misty Terrain prevents all status conditions for grounded Pokemon and boosts Fairy-type moves by 30%. Overrides existing terrain."
}
ability {
  id: ABILITY_GRASSY_SURGE
  name: "Grassy Surge"
  description: "Casts Grassy Terrain on entry. Lasts 8 turns."
  expanded_description: "Creates Grassy Terrain for 8 turns (12 with Terrain Extender) on entry. Grounded Pokemon heal 1/16 HP per turn and Grass moves gain 30% power. Overrides other terrains."
}
ability {
  id: ABILITY_FULL_METAL_BODY
  name: "Full Metal Body"
  description: "Immune to stat drops."
  expanded_description: "Full Metal Body gives immunity to all stat reductions from moves and abilities. Includes self stat drops from moves like Overheat."
}
ability {
  id: ABILITY_SHADOW_SHIELD
  name: "Shadow Shield"
  description: "At full HP, halves damage taken from attacks"
  expanded_description: "Shadow Shield halves damage from all attacks when at full HP. Multiplicative with other damage reduction sources."
}
ability {
  id: ABILITY_PRISM_ARMOR
  name: "Prism Armor"
  description: "Takes 35% less damage from Super-effective moves."
  expanded_description: "Reduces damage from super-effective attacks by 35%. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_NEUROFORCE
  name: "Neuroforce"
  description: "Grants an additional 1.35x boost to Super-effective moves."
  expanded_description: "Super effective attacks are boosted by 35%."
}
ability {
  id: ABILITY_INTREPID_SWORD
  name: "Intrepid Sword"
  description: "On entry, raises Attack by one stage."
  expanded_description: "Intrepid Sword raises the Pokemon's Attack stat by one stage when switching into battle."
}
ability {
  id: ABILITY_DAUNTLESS_SHIELD
  name: "Dauntless Shield"
  description: "On entry, raises Defense by one stage."
  expanded_description: "Dauntless Shield immediately raises Defense by one stage when entering battle."
}
ability {
  id: ABILITY_LIBERO
  name: "Libero"
  description: "Before using a move, changes its type to the move's type."
  expanded_description: "Libero overrides the user's type to match the move being used before it attacks. Cannot activate on Struggle moves."
}
ability {
  id: ABILITY_BALL_FETCH
  name: "Ball Fetch"
  description: "No effect in battle."
  expanded_description: "No effect in battle."
}
ability {
  id: ABILITY_COTTON_DOWN
  name: "Cotton Down"
  description: "Lowers the Speed of all foes by one stage when hit."
  expanded_description: "Cotton Down triggers when the Pokemon is hit by any attack, lowering the Speed of ALL Pokemon by one stage. Activates multiple times against multihit moves."
}
ability {
  id: ABILITY_PROPELLER_TAIL
  name: "Propeller Tail"
  description: "Swift Swim + Redirection Immunity."
  expanded_description: "Propeller Tail boosts the user's Speed by 50% during rain and grants immunity to redirection effects. The speed boost works in all forms of rain."
}
ability {
  id: ABILITY_MIRROR_ARMOR
  name: "Mirror Armor"
  description: "Bounces back any stat drops inflicted by an enemy."
  expanded_description: "Mirror Armor reflects all stat-lowering effects aimed at the user back to the attacker. The reflection bypasses immunities."
}
ability {
  id: ABILITY_GULP_MISSILE
  name: "Gulp Missile"
  description: "Gulps a prey after Dive/Surf. If hit, shoots prey at enemy."
  expanded_description: "When Cramorant uses Surf, Triple Dive or Dive, it catches prey: Gulping form if HP >50% or Gorging form if HP <=50%. When hit in either form, spits prey dealing 25% max HP damage to attacker and returns to base. Gulping Form also lowers Defense by 1; Gorging Form paralyzes. Cannot be suppressed etc."
}
ability {
  id: ABILITY_STALWART
  name: "Stalwart"
  description: "Isn't affected by redirection, crits, or ability suppression."
  expanded_description: "Can't have its moves redirected, can't be critically hit, and can't have its abilities suppressed. Ability suppression includes effects such as Mold Breaker, Gastro Acid, Neutralizing Gas, and Mycelium Might."
}
ability {
  id: ABILITY_STEAM_ENGINE
  name: "Steam Engine"
  description: "Maximizes Speed if hit by a Fire-type or Water-type attack."
  expanded_description: "Steam Engine maximizes the Speed stat to +6 stages when hit by any Fire-type or Water-type move. The boost occurs immediately after taking damage."
}
ability {
  id: ABILITY_PUNK_ROCK
  name: "Punk Rock"
  description: "Sound moves deal 1.3x more dmg. Takes -50% dmg from sound moves."
  expanded_description: "Punk Rock amplifies the user's sound moves by 30% and reduces incoming sound move damage by 50%. Damage reduction is multiplicative with other sources."
}
ability {
  id: ABILITY_SAND_SPIT
  name: "Sand Spit"
  description: "Summons a sandstorm when hit. Attacker is then grounded."
  expanded_description: "When damaged by an attack summons an 8-turn sandstorm if one isn't present. If a sandstorm is summoned the attacker is knocked to the ground. The user gains immunity to sandstorm damage. Does not activate if the user faints from the attack."
}
ability {
  id: ABILITY_ICE_SCALES
  name: "Ice Scales"
  description: "Halves damage taken by Special moves. Does NOT double SpDef."
  expanded_description: "Halves all incoming Special Attack damage. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_RIPEN
  name: "Ripen"
  description: "Doubles resistance, healing and stat raises provided by Berries."
  expanded_description: "Ripen doubles all beneficial berry effects. Healing berries restore twice as much HP, stat-boosting berries raise stats by 2 stages instead of 1, resist berries reduce super-effective damage by 75% instead of 50%, and PP-restoring berries restore twice as much PP."
}
ability {
  id: ABILITY_ICE_FACE
  name: "Ice Face"
  description: "Protects once against an attack. Restores protection under hail."
  expanded_description: "Ice Face transforms Eiscue into its Noice Face form after taking a physical attack, negating damage once. While in Noice form, if hail is set or if the user is swapped in, revert to Ice Face form. Cannot be copied or suppressed."
}
ability {
  id: ABILITY_POWER_SPOT
  name: "Power Spot"
  description: "Grants a 1.3x boost to ally's attacks."
  expanded_description: "Power Spot boosts allies' attack power by 30% in double battles. The user itself receives no boost."
}
ability {
  id: ABILITY_MIMICRY
  name: "Mimicry"
  description: "Changes type depending on active Terrain."
  expanded_description: "Mimicry changes the Pokemon's type to match active terrain: Electric on Electric Terrain, Fairy on Misty Terrain, Grass on Grassy Terrain, or Psychic on Psychic Terrain. The type change persists until terrain ends or the Pokemon switches out. Retains type changes from moves like Soak."
}
ability {
  id: ABILITY_SCREEN_CLEANER
  name: "Screen Cleaner"
  description: "Clears screens from both sides on entry. Can reset screens."
  expanded_description: "Screen Cleaner removes all protective screens from both sides of the battlefield - Reflect, Light Screen, Aurora Veil, and Smokescreen - when the Pokemon enters battle. It also allows the Pokemon to set screens while they are already active, refreshing their duration."
}
ability {
  id: ABILITY_STEELY_SPIRIT
  name: "Steely Spirit"
  description: "Boosts own & ally's Steel-type moves by 1.3x."
  expanded_description: "Steely Spirit increases the power of Steel-type moves by 30% for both the user and its allies in battle."
}
ability {
  id: ABILITY_PERISH_BODY
  name: "Perish Body"
  description: "Uses Perish Song when hit by a contact move."
  expanded_description: "When hit by a contact move, Perish Body activates Perish Song on both the user and the attacker. Both Pokemon will faint in 3 turns unless they switch out."
}
ability {
  id: ABILITY_WANDERING_SPIRIT
  name: "WandrngSprit"
  description: "Trades ability with attacker on contact."
  expanded_description: "When hit by a contact move, Wandering Spirit swaps abilities with the attacker. Both Pokemon regain their original ability upon switching out. Cannot swap with abilities that are also unable to be copied or suppressed."
}
ability {
  id: ABILITY_GORILLA_TACTICS
  name: "Gorilla Tactics"
  description: "Raises own Atk by 1.5x, but can only use the first chosen move."
  expanded_description: "Gorilla Tactics boosts physical move power by 50% but locks the user into using the first move selected until they switch out."
}
ability {
  id: ABILITY_NEUTRALIZING_GAS
  name: "Neutralizing Gas"
  description: "All abilities are nullified."
  expanded_description: "Fills the area with gas that completely suppresses all abilities except unsuppressable ones. Effect lasts while user is on field. After the user attempts to switch, all suppressed abilities reactivate their entry effects. Cannot be copied or swapped."
}
ability {
  id: ABILITY_PASTEL_VEIL
  name: "Pastel Veil"
  description: "Casts Safeguard on entry."
  expanded_description: "Pastel Veil automatically sets up Safeguard for the user's team when the Pokemon enters battle. Safeguard lasts for 5 turns and protects all team members from status conditions."
}
ability {
  id: ABILITY_HUNGER_SWITCH
  name: "HungerSwitch"
  description: "Changes between Full and Hangry forms after each turn."
  expanded_description: "Automatically switches between Full and Hangry forms at the end of each turn. Cannot be overridden, suppressed, swapped, or copied in any way."
}
ability {
  id: ABILITY_QUICK_DRAW
  name: "Quick Draw"
  description: "30% chance to move first."
  expanded_description: "Quick Draw gives a 30% chance for the user to act first in their priority bracket. Stacks multiplicatively with Quick Claw for a 44% chance to activate."
}
ability {
  id: ABILITY_UNSEEN_FIST
  name: "Unseen Fist"
  description: "Contact moves strike through protection."
  expanded_description: "Unseen Fist allows all contact moves to bypass protection moves and ignore any secondary effects associated with them."
}
ability {
  id: ABILITY_CURIOUS_MEDICINE
  name: "CuriusMedicn"
  description: "Resets its ally's stat changes on entry."
  expanded_description: "Curious Medicine removes an ally's positive and negative stat changes on the user's entry."
}
ability {
  id: ABILITY_TRANSISTOR
  name: "Transistor"
  description: "Boosts the power of Electric-type moves by 1.5x."
  expanded_description: "Transistor increases the power of all Electric-type moves by 50%. Stacks additively with other damage modifiers."
}
ability {
  id: ABILITY_DRAGONS_MAW
  name: "Dragon's Maw"
  description: "Boosts the power of Dragon-type moves by 1.5x."
  expanded_description: "Dragon's Maw boosts the power of Dragon-type moves by 50%."
}
ability {
  id: ABILITY_CHILLING_NEIGH
  name: "ChillngNeigh"
  description: "KOs raise Attack by one stage."
  expanded_description: "When this Pokemon knocks out an opponent with a direct attack, its Attack stat increases by one stage."
}
ability {
  id: ABILITY_GRIM_NEIGH
  name: "Grim Neigh"
  description: "KOs raise Sp. Atk by one stage."
  expanded_description: "Grim Neigh boosts the Pokemon's Special Attack by one stage when it causes an opponent to faint with a direct attack."
}
ability {
  id: ABILITY_AS_ONE_ICE_RIDER
  name: "As One"
  description: "Unnerve + Chilling Neigh."
  expanded_description: "Prevents all opposing Pokemon from consuming held items. Raise Attack by one stage when the user knocks out an opponent with a direct attack."
}
ability {
  id: ABILITY_AS_ONE_SHADOW_RIDER
  name: "As One"
  description: "Unnerve + Grim Neigh."
  expanded_description: "Prevents all opposing Pokemon from consuming held items. Raise Special Attack by one stage when the user knocks out an opponent with a direct attack."
}
ability {
  id: ABILITY_CHLOROPLAST
  name: "Chloroplast"
  description: "Weather Ball, Solar Beam/Blade, Growth act as if used in sun."
  expanded_description: "Weather Ball doubles power and becomes Fire-type. Solar moves charge instantly. Growth boosts Attack and Special Attack by 2 stages. Moonlight, Morning Sun, and Synthesis recover 2/3 of your max HP. Grass and Water Pledge creates a sea of fire or rainbow respectively."
}
ability {
  id: ABILITY_WHITEOUT
  name: "Whiteout"
  description: "Ups highest attacking stat by 1.5x in hail."
  expanded_description: "Whiteout boosts the Pokemon's highest attacking stat by 50% during hail. Also grants immunity to hail damage."
}
ability {
  id: ABILITY_PYROMANCY
  name: "Pyromancy"
  description: "Moves inflict burn 5x as often."
  expanded_description: "Pyromancy multiplies the burn chance of all moves by 5x. Does not interact with Flame Body."
}
ability {
  id: ABILITY_KEEN_EDGE
  name: "Keen Edge"
  description: "Boosts the power of slashing moves by 1.3x."
  expanded_description: "Keen Edge boosts all slashing attacks by 30%."
}
ability {
  id: ABILITY_PRISM_SCALES
  name: "Prism Scales"
  description: "Takes 30% less damage from Special attacks."
  expanded_description: "Prism Scales reduces damage from all Special attacks by 30%. Stacks multiplicatively with other damage reduction sources."
}
ability {
