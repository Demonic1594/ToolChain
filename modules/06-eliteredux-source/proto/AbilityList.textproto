}
ability {
  id: ABILITY_HASTE_MAKES_WASTE
  name: "Haste Makes Waste"
  description: "Stall + Analytic."
  expanded_description: "Reduces damage by 30% if the user has not moved yet. Multiplicative with other damage reduction sources. Works when the user switches in mid-turn. Boosts damage by 30% if the target has already moved this turn."
}
ability {
  id: ABILITY_HUNGRY_MAWS
  name: "Hungry Maws"
  description: "Strong Jaw + Jaws of Carnage."
  expanded_description: "Bite and jaw moves are boosted by 30%. Restores 50% max HP when defeating foes with biting moves or 25% with other moves. Only activates when knocking out a target with a direct hit."
}
ability {
  id: ABILITY_THERMAL_SLIDE
  name: "Thermal Slide"
  description: "Ups speed by 50% in sun or hail."
  expanded_description: "Boosts the Pokemon's Speed by 50% during hail or sun. Also grants immunity to hail damage."
}
ability {
  id: ABILITY_THERMOMANCY
  name: "Thermomancy"
  description: "Pyromancy + Cryomancy."
  expanded_description: "Multiplies the chance of inflicting burn or frostbite by 5x on all moves. Does not interact with Flame Body or Freezing Point."
}
ability {
  id: ABILITY_CHUCKSTER
  name: "Chuckster"
  description: "Once per entry, halves contact dmg then forces attacker out."
  expanded_description: "Once per entry when receiving a contact move, gain 50% damage reduction and force out the attacker. Multiplicative with other sources of damage reduction."
}
ability {
  id: ABILITY_HEAT_SINK
  name: "Heat Sink"
  description: "Redirects Fire moves. Absorbs them, ups highest Atk."
  expanded_description: "Draws in Fire-type moves and gain immunity to them. Additionally, Fire-type moves boost the highest attacking stat of the user by one stage."
}
ability {
  id: ABILITY_RELIC_STONE
  name: "Relic Stone"
  description: "Other battlers don't benefit from STAB."
  expanded_description: "While the user is on field, every other Pokemon does not receive a STAB bonus from typing or abilities."
}
ability {
  id: ABILITY_SUPERCELL
  name: "Supercell"
  description: "Drizzle + Electro Surge."
  expanded_description: "Summons rain and Electric Terrain upon entry, lasting 8 turns (12 with Damp Rock/Terrain Extender). Boosts Water moves by 50% and cuts Fire damage by 50%. Grounded Pokemon cannot fall asleep and Electric moves gain 30% power boost."
}
ability {
  id: ABILITY_LIGHTNING_ASPECT
  name: "Lightning Aspect"
  description: "Absorbs electric moves then ups highest stat by +1."
  expanded_description: "Absorbs Electric moves for immunity and boosts higher attacking stat by +1. Compares Attack vs Special Attack to determine boost target. Excellent for setup against Electric attacks while providing defensive immunity and offensive gains"
}
ability {
  id: ABILITY_FIRE_ASPECT
  name: "Fire Aspect"
  description: "Absorbs fire moves and always burns with fire."
