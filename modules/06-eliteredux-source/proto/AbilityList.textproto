}
ability {
  id: ABILITY_BIOFILM
  name: "Biofilm"
  description: "Boosts Special Defense by 50% in Toxic Terrain."
  expanded_description: "Boosts the user's Special Defense stat by 50% when in Toxic Terrain."
}
ability {
  id: ABILITY_CHOKEHOLD
  name: "Chokehold"
  description: "Trapping moves paralyze and lower speed by -1 each turn."
  expanded_description: "When the user traps a target, they inflict paralysis and drop the target's speed by one stage every turn while trapped."
}
ability {
  id: ABILITY_GUARDIAN_COAT
