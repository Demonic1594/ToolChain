  description: "Summons the Swamp Pledge effect on entry."
}
ability {
  id: ABILITY_FROSTY_PRESCENCE
  name: "Frosty Presence"
  description: "Uses Mist on entry."
}
ability {
  id: ABILITY_CHILLING_PELLETS
  name: "Chilling Pellets"
  description: "Uses 13BP Icicle Spear when hit by contact."
}
ability {
  id: ABILITY_PAINT_SHOT
  name: "Paint Shot"
  description: "Mega launcher moves change the target's type to the move used."
}
ability {
  id: ABILITY_STONECUTTER
  name: "Stonecutter"
  description: "Fossilized + Rock moves ignore abilities."
}
ability {
  id: ABILITY_EDGELORD
  name: "Edgelord"
  description: "First Keen Edge move each entry gets +1 priority. Resets on KO."
}
ability {
  id: ABILITY_WARMONGER
  name: "Warmonger"
  description: "Boosts the user's Rock, Steel, and Fighting moves by 30%."
}
ability {
  id: ABILITY_LOCUST_SWARM
  name: "Locust Swarm"
  description: "Changes into Hivemind form until 1/4 HP or less."
}
ability {
  id: ABILITY_REVELATION
  name: "Revelation"
  description: "Changes into Revelation form until 1/4 HP or less."
}
ability {
  id: ABILITY_CURSE_OF_FAMINE
  name: "Curse of Famine"
  description: "Eats terrain, restores hp, and boosts a defense."
}
ability {
  id: ABILITY_CRYSTALLINE_ARMOR
  name: "Crystalline Armor"
