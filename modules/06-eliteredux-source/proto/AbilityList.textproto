}
ability {
  id: ABILITY_AQUATIC_DWELLER
  name: "Aquatic Dweller"
  description: "Aquatic + Boosts the power of Water-type moves by 1.5x."
  expanded_description: "Upon entering battle, adds Water to the user's current typing. Retains Water typing even upon losing the ability, going away only when switching out. Also boosts the power of Water-type moves by 50%."
}
ability {
  id: ABILITY_APPLE_PIE
  name: "Apple Pie"
  description: "Self Sufficient + Ripen."
  expanded_description: "Restores 1/16 of the Pokemon's maximum HP at the end of each turn. Ripen doubles all beneficial berry effects. Healing berries restore twice as much HP, stat-boosting berries raise stats by 2 stages, resist berries reduce super-effective damage by 75%, and PP-restoring berries restore 20 PP."
}
ability {
  id: ABILITY_HOVER
  name: "Hover"
  description: "Adds Psychic type to itself. Avoids Ground attacks."
  expanded_description: "Upon entering battle, adds Psychic to the user's current typing. Retains Psychic typing even upon losing the ability, going away only when switching out. The user is immune to Ground-type moves and other ground effects such as Spikes and terrains."
}
ability {
  id: ABILITY_DEPRAVITY
  name: "Depravity"
  description: "Merciless + Overcharge."
  expanded_description: "Guarantees critical hits against targets who are poisoned, paralyzed, bleeding, or have their speed lowered. The user's Electric-type moves become effective against Electric-type Pokemon, dealing 2x damage instead of 0.5x. Also allows the user to paralyze Electric-types."
}
ability {
  id: ABILITY_WILDFIRE
  name: "Wildfire"
  description: "Attacks with Fire Spin on entry."
  expanded_description: "Uses Fire Spin upon switching into battle, a 50 BP Fire-type Special move that traps the opponent for 4-5 turns. The target takes 1/8 max HP damage each turn and cannot switch out until the trap ends."
}
ability {
  id: ABILITY_JUMP_SCARE
  name: "Jumpscare"
  description: "Attacks with Astonish on first switch-in."
  expanded_description: "Uses Astonish on switch in, a 40 BP Ghost-type Physical move with +3 priority that always causes flinching. Once per battle."
}
ability {
  id: ABILITY_TAR_TOSS
  name: "Tar Toss"
  description: "Uses Tar Shot on switch-in."
  expanded_description: "Uses Tar Shot on switch in, lowering the target's Speed by one stage and making them take double damage from Fire-type moves. Does not stack the Fire-type damage debuff on successive uses."
}
ability {
  id: ABILITY_STUN_SHOCK
  name: "Stun Shock"
  description: "Attacks have a 60% chance to Paralyze or Poison."
  expanded_description: "When the user lands an attack, there's a 60% chance of inflicting poison or paralysis, chosen randomly. Multihits roll the activation chance on each hit."
}
ability {
  id: ABILITY_RAGING_GODDESS
  name: "Raging Goddess"
  description: "Rampage + Hyper Aggressive."
  expanded_description: "Eliminates recharge turns when the user successfully KOs an opponent with a direct attack. Makes all attacks hit twice in succession. The first hit deals 100%, while the second hit deals 25%. Each hit rolls secondary effects independently (except flinch)."
}
ability {
  id: ABILITY_WHIPLASH
